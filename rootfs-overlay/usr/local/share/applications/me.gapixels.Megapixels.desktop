# M52XQ: overrides /usr/share/applications/me.gapixels.Megapixels.desktop (/usr/local/share comes first in XDG_DATA_DIRS):
# Megapixels is started through m52xq-megapixels, which closes plasma-camera completely first (m52xq-camera-launch).
# The package file is replaced on every apk install of megapixels (r59 did it: "Resource busy" after plasma-camera).
[Desktop Entry]
Name=Megapixels
Exec=/usr/local/bin/m52xq-megapixels
Terminal=false
Type=Application
Categories=GTK;Photography;Graphics;
Keywords=picture;photos;camera;
Icon=me.gapixels.Megapixels
X-Purism-FormFactor=Workstation;Mobile;
X-Phosh-UsesFeedback=true
StartupNotify=true
