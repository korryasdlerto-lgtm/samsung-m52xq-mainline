#!/usr/bin/python3
# M52XQ: play the sound of a notification. Plasma Mobile (mobileshell) draws the notification card but ignores the "sound-file" /
# "sound-name" hints, and apps such as Telegram Desktop hand their sound to the daemon (it advertises the "sound" capability),
# so no sound was heard (30.10). This listens to org.freedesktop.Notifications.Notify on the session bus and plays the sound with
# paplay. A notification with "suppress-sound" is silent; apps that play their own sound (Spacebar via KNotification) are skipped.
import os, re, subprocess, sys

SKIP_APPS = {"Spacebar", "Network Management", "Управление сетью"}
# stream volume (65536 = 100%): the sink itself sits at 30% and the Telegram sound is quiet, 30.10
VOLUME = 65536
THEMES = ("ocean", "oxygen", "freedesktop")

def theme_file(name):
    for t in THEMES:
        for ext in ("oga", "ogg", "wav"):
            p = "/usr/share/sounds/%s/stereo/%s.%s" % (t, name, ext)
            if os.path.exists(p):
                return p
    return None

def handle(block):
    strs = re.findall(r'^\s*string "(.*)"$', block, re.M)
    app = strs[0] if strs else ""
    if app in SKIP_APPS:
        print("notification from \"%s\": skipped" % app, flush=True)
        return
    if re.search(r'"suppress-sound"\s+variant\s+boolean true', block):
        print("notification from \"%s\": suppress-sound" % app, flush=True)
        return
    path = None
    m = re.search(r'"sound-file"\s+variant\s+string "([^"]+)"', block)
    if m and os.path.exists(m.group(1)):
        path = m.group(1)
    if not path:
        m = re.search(r'"sound-name"\s+variant\s+string "([^"]+)"', block)
        if m:
            path = theme_file(m.group(1))
    if not path:
        print("notification from \"%s\": no sound hint" % app, flush=True)
        return
    print("notification from \"%s\": playing %s" % (app, path), flush=True)
    subprocess.Popen(["paplay", "--volume=%d" % VOLUME, path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    p = subprocess.Popen(["dbus-monitor", "--session", "interface='org.freedesktop.Notifications',member='Notify'"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    block = None
    for line in p.stdout:
        if line.startswith(("method call", "signal", "method return", "error")):
            if block is not None:
                handle(block)
            block = line if "member=Notify" in line else None
        elif block is not None:
            block += line
            # the last argument of Notify (expire_timeout) closes the call: play at once, not at the next message
            if re.match(r"^   int32 -?\d+$", line):
                handle(block)
                block = None
    if block is not None:
        handle(block)
    return 1

sys.exit(main())
