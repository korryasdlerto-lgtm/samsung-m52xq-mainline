#!/bin/sh
# M52XQ: per-app location permissions (GeoClue), used by gps-permissions.qml.
#   m52xq-gps-apps list              -> "<desktop-id>|<Name>|allow|deny|ask" per app
#   m52xq-gps-apps set <id> allow|deny|ask
# State lives in ~/.config/m52xq-geoclue-apps; root unit m52xq-gps-perms.path
# turns it into /etc/geoclue/conf.d/90-m52xq-apps.conf.
F="${XDG_CONFIG_HOME:-$HOME/.config}/m52xq-geoclue-apps"
case "$1" in
list)
	for f in /usr/share/applications/*.desktop; do
		grep -qE '^(NoDisplay|Hidden)=true' "$f" && continue
		grep -q '^Type=Application' "$f" || continue
		id=${f##*/}; id=${id%.desktop}
		case "$id" in kcm_*|*.daemon|org.freedesktop.*|org.gnome.*|org.kde.plasma.*|signon-ui|ktelnet*|mimeinfo*) continue ;; esac
		name=$(grep -m1 '^Name=' "$f" | cut -d= -f2-)
		st=$(grep -m1 "^$id=" "$F" 2>/dev/null | cut -d= -f2)
		echo "$id|${name:-$id}|${st:-ask}"
	done | sort -t'|' -k2 -f
	;;
set)
	case "$2" in ''|*[!A-Za-z0-9._-]*) exit 2 ;; esac
	case "$3" in allow|deny|ask) ;; *) exit 2 ;; esac
	mkdir -p "${F%/*}"
	touch "$F"
	{ grep -v "^$2=" "$F"; [ "$3" = ask ] || echo "$2=$3"; } > "$F.new"
	cat "$F.new" > "$F"
	rm -f "$F.new"
	;;
*)
	echo "usage: $0 list | set <id> allow|deny|ask" >&2
	exit 2
	;;
esac
