#!/bin/sh
# M52XQ: give the cameras to the application you are using right now.
# The phone cameras can be used by ONE application at a time (plasma-camera, Megapixels, the virtual webcams for Telegram ...).
#   m52xq-camera-grab           once: every other camera user is closed, the foreground application gets the cameras
#   m52xq-camera-grab --watch   keeps doing it whenever another application comes to the foreground
# A camera user = a process holding /dev/video*, /dev/media0 or running a camera pipeline of the virtual webcams.
export XDG_RUNTIME_DIR=/run/user/10000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/10000/bus
JS=/usr/local/share/m52xq/active-window.js
KNOWN="plasma-camera megapixels"			# native camera apps: closed when another application is in front
VCAM_APPS="Telegram firefox chromium"			# applications that use the virtual webcams

active() { # prints "<pid> <class>"
	qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript m52xq-active >/dev/null 2>&1
	id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$JS" m52xq-active 2>/dev/null)
	[ -n "$id" ] || return 1
	qdbus6 org.kde.KWin /Scripting/Script$id org.kde.kwin.Script.run >/dev/null 2>&1
	sleep 0.4
	journalctl --user -b --no-pager -n 30 2>/dev/null | grep -a "M52XQ_ACTIVE" | tail -1 | sed 's/.*M52XQ_ACTIVE //'
	qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript m52xq-active >/dev/null 2>&1
}

descends() { # $1 pid, $2 ancestor pid
	p=$1
	while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null; do
		[ "$p" = "$2" ] && return 0
		p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null)
	done
	return 1
}

grab() {
	set -- $(active)
	apid=$1; acls=$2
	[ -n "$apid" ] || { echo "cannot find the active window" >&2; return 1; }
	echo "active: $acls (pid $apid)"
	for name in $KNOWN; do
		for p in $(pgrep -x "$name"); do
			descends "$p" "$apid" && continue
			[ "$p" = "$apid" ] && continue
			echo "closing $name ($p)"; kill "$p"
		done
	done
	# the virtual webcams: keep them only when the application in front is one that reads them
	case " $VCAM_APPS " in *" $acls "*) ;; *) /usr/local/bin/m52xq-virtualcam switch off >/dev/null 2>&1 ;; esac
}

if [ "$1" = "--watch" ]; then
	last=
	while :; do
		cur=$(active)
		if [ -n "$cur" ] && [ "$cur" != "$last" ]; then grab >/dev/null; last=$cur; fi
		sleep 2
	done
else
	grab
fi
