#!/bin/sh
# M52XQ: on a clean install PulseAudio starts the speaker at 100 % (0 dB) - far too loud for the amplifier (31.10.2026: the
# speaker nearly blew). Once per fresh /home/user: set 35 %; a volume the user chooses later is remembered by PulseAudio.
F="$HOME/.config/m52xq-volume-init-done"
[ -e "$F" ] && exit 0
i=0
while [ $i -lt 90 ]; do
	pactl list short sinks 2>/dev/null | grep -q HiFi__Speaker && break
	sleep 1; i=$((i + 1))
done
pactl set-sink-volume @DEFAULT_SINK@ 35% && mkdir -p "$HOME/.config" && touch "$F"
