#!/bin/sh
# M52XQ (v47): NFC polling only while the display is on, like Android.
# Run by m52xq-nfc-poll.service while NFC is switched on (m52xq-nfc-power on/off).
#  - display on : chip powered and a poll loop running. Seen live (2026-11-05):
#                 * nfctool's "RF Mode" / "Tags" are stale (kept after the card is gone and over a power cycle),
#                 * neard's "Polling" was once true with no poll in the chip (right after neard started),
#                 * restarting the loop again and again is what made ~70 irq/s (a polling chip is silent).
#                 So: polling = neard Polling or a neard tag object; a start counts only when the chip answers
#                 (its interrupt count grows); otherwise power-cycle the chip through neard and start again.
#                 neard's ConstantPoll restarts the loop after a card (a card left on the phone is found again and
#                 again, ~25 irq/s -- that is neard, not us); restarted only if two checks 5 s apart find no polling.
#                 Without a card a running poll is silent (0 irq/s, measured).
#  - display off: poll loop stopped and the chip powered off (no RF field, no interrupts while asleep).
DEV=nfc0
OBJ=/org/neard/$DEV
IF=org.neard.Adapter

nd() { busctl --system "$@" >/dev/null 2>&1; }
display_on() { grep -qx On /sys/class/drm/card*-DSI-1/dpms 2>/dev/null; }
irqs() { awk '/s3fwrn5/ { s = 0; for (i = 2; i <= NF; i++) if ($i ~ /^[0-9]+$/) s += $i; else break; print s }' /proc/interrupts; }
polling() {
	busctl --system get-property org.neard $OBJ $IF Polling 2>/dev/null | grep -q true && return 0
	busctl --system tree org.neard 2>/dev/null | grep -q "$OBJ/tag"
}
power() { nd set-property org.neard $OBJ $IF Powered b "$1"; }

# start a poll loop and check that the chip answered
try_start() {
	a=$(irqs)
	nd call org.neard $OBJ $IF StartPollLoop s Initiator || return 1
	sleep 0.5
	b=$(irqs)
	[ -n "$a" ] && [ -n "$b" ] && [ "$b" -gt "$a" ]
}

start_poll() {
	try_start && return 0
	nd call org.neard $OBJ $IF StopPollLoop
	power false
	sleep 0.5
	power true
	sleep 0.5
	try_start
}

# neard must have registered the adapter
for i in $(seq 1 20); do
	busctl --system introspect org.neard $OBJ $IF >/dev/null 2>&1 && break
	sleep 1
done

last=""
n=0
miss=0
while :; do
	if display_on; then
		if [ "$last" != on ]; then
			power true
			sleep 0.5
			start_poll
			last=on
			n=1
			miss=0
		elif [ $((n % 5)) = 0 ]; then
			if polling; then
				miss=0
			else
				miss=$((miss + 1))
				[ $miss -ge 2 ] && start_poll && miss=0
			fi
		fi
		n=$((n + 1))
	elif [ "$last" != off ]; then
		nd call org.neard $OBJ $IF StopPollLoop
		power false
		last=off
	fi
	sleep 1
done
