# m52xq: let the USB controller and its PHY runtime-suspend when no cable is attached
# (default power/control=on keeps the PHY regulators pm7325_l2, pm8350c_l1 and refgen enabled; Lineage has them off)
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="a600000.ssusb", ATTR{power/control}="auto"
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="88e3000.hsphy", ATTR{power/control}="auto"
