[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm ADSP - sensorspd
# m52xq в44: no Conflicts=/Before=suspend.target: the service is no longer stopped before every suspend and started again
# after every resume (546 restarts of the ADSP FastRPC server in one night of Wi-Fi wake-ups).
# This service shouldn't be run on devices with an SDSP
ConditionPathExists=!/dev/fastrpc-sdsp
ConditionPathExists=/dev/fastrpc-adsp

[Service]
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
