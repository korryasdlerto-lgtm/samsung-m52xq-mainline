[Unit]
Description=Restore last manually-set password from backup, if any
DefaultDependencies=no
Before=sysinit.target
After=m52xq-set-default-password.service
ConditionPathExists=/etc/.m52xq-shadow-backup

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/cp -a /etc/.m52xq-shadow-backup /etc/shadow

[Install]
WantedBy=sysinit.target
