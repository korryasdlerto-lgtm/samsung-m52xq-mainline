[Unit]
Description=Set default login/root password to 112233 on first boot after a fresh v7 flash
DefaultDependencies=no
Before=sysinit.target
ConditionPathExists=!/etc/.m52xq-default-password-set

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'printf "user:112233\nroot:112233\n" | chpasswd && touch /etc/.m52xq-default-password-set'

[Install]
WantedBy=sysinit.target
