# Kernel config based on: arch/arm64/configs/fp5_defconfig
maintainer=""
pkgname=linux-samsung-m52xq
pkgver=7.1.2
pkgrel=1
_commit=17425f528fe51fef6e86847e92baffab3b78623e
pkgdesc="Samsung Galaxy M52 5G kernel fork"
arch="aarch64"
url="https://kernel.org"
license="GPL-2.0-only"
makedepends="
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	zstd
	"
source="
	$pkgname-$_commit.tar.gz::https://github.com/sc7280-mainline/linux/archive/$_commit.tar.gz
	config-${pkgname#linux-}.$arch
	"
builddir="$srcdir/linux-$_commit"
options="
	!check
	!strip
	!tracedeps
	pmb:cross-native
	"

_carch="arm64"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor'.
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	cp "$srcdir"/config-${pkgname#linux-}.$arch .config
}

build() {
	# Dummy stub: the real kernel/vendor_boot for this device is built and
	# flashed separately (surgical devicetree-blob editing + Alpine-chroot
	# clang build against the actual local kernel tree). This package only
	# needs to exist to satisfy pmbootstrap's dependency chain when
	# generating the userspace rootfs image, so its actual kernel binary
	# content is never used or flashed.
	:
}

package() {
	mkdir -p "$pkgdir"/boot
	mkdir -p "$pkgdir"/usr/share/kernel/"${pkgname#linux-}"
	echo "dummy" > "$pkgdir"/usr/share/kernel/"${pkgname#linux-}"/kernel.release

	# boot-deploy just copies whatever matches /boot/vmlinuz* -- it's
	# never flashed (real kernel/vendor_boot are built and flashed
	# separately, see build() above), it only needs to exist so
	# boot-deploy's mkinitfs trigger doesn't abort the apk transaction.
	echo "dummy" > "$pkgdir"/boot/vmlinuz-"${pkgname#linux-}"
}

sha512sums="
a0dff8324718f3ababfe058cdfd180ab2f48cb09da4aa6a8086617ff91d5121ff4bf68dbc7f0711deaf87d87653e3baff996e72fd1d140d4f8664909929d9fc8  linux-samsung-m52xq-17425f528fe51fef6e86847e92baffab3b78623e.tar.gz
2da70ac8783cad4d66383f424ff07d0e71933ad6caf5ea2a5e62c6dc8c76a7ffd878e98b3e86a9c8657145c59463ff9ca28b64107305b085f8cb931bdff21650  config-samsung-m52xq.aarch64
"
