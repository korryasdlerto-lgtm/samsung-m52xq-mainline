862714d94206e5d9b00c5a00c9b6c22b200438dbb6b8d638ecfe4622d7924777d9fd86c6087ccf1b8ac6d7a87633cc8bf7c5ca07dc79d48f7e0a162cedb7a427  libdng-0001-repacked-stride.patch
