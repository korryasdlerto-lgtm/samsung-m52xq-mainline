+void PlasmaCameraManager::setFlashMode(int mode)
+{
+    mode = qBound(0, mode, 2);
+    if (m_flashMode == mode) {
+        return;
+    }
+    m_flashMode = mode;
+    if (mode == 1 && !m_lightSensor.isActive()) {
+        m_lightSensor.start();
+    }
