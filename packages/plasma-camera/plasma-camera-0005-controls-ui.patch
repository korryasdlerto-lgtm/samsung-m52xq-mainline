+qreal PlasmaCameraManager::minZoom() const
+{
+    const QString cam = m_plasmaCamera ? m_plasmaCamera->cameraDevice() : QString();
+    const bool recording = m_recorder && m_recorder->recorderState() == QMediaRecorder::RecordingState;
+    // the logical camera switches the sensor, which is not possible while a video is being recorded
+    if (!m_plasmaCamera || !m_plasmaCamera->logicalMode()) {
+        return 1.0;
+    }
+    if (isUltrawideCamera(cam)) {
+        return 0.5;
+    }
+    return (isMainCamera(cam) && !recording) ? 0.5 : 1.0;
+}
+
+// zoom of the digital crop: the ultrawide camera is already 0.5x, so logical zoom z needs a crop of z / 0.5
+qreal PlasmaCameraManager::effectiveZoom() const
+{
+    const QString cam = m_plasmaCamera ? m_plasmaCamera->cameraDevice() : QString();
+    const bool logical = m_plasmaCamera && m_plasmaCamera->logicalMode();
+    return (logical && isUltrawideCamera(cam)) ? qMax<qreal>(1.0, m_zoom / 0.5) : qMax<qreal>(1.0, m_zoom);
+}
