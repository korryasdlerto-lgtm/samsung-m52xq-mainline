--- a/src/contents/ui/camera/CameraSettingsStrip.qml	1970-01-01 02:00:00.000000000 +0200
+++ b/src/contents/ui/camera/CameraSettingsStrip.qml	2026-10-04 19:44:18.873674008 +0300
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// m52xq: ISO / EXP / FOCUS / FLASH buttons in the style of Megapixels.
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasmacamera
+
+Item {
+    id: root
+
+    required property PlasmaCamera camera
+    required property PlasmaCameraManager captureSession
+
+    // which slider panel is open: "", "iso", "exp", "focus"
+    property string openPanel: ""
+    // buttons per row: 4 in portrait, 2 (two rows) in landscape
+    property int columns: 4
+
+    implicitWidth: buttons.implicitWidth
+    implicitHeight: buttons.implicitHeight + (panel.visible ? panel.implicitHeight + Kirigami.Units.smallSpacing : 0)
+
+    Kirigami.Theme.inherit: false
+    Kirigami.Theme.colorSet: Kirigami.Theme.Complementary
+
+    Timer {
+        id: closeTimer
+        interval: 900
+        onTriggered: root.openPanel = ""
+    }
+
+    function togglePanel(name) {
+        openPanel = (openPanel === name) ? "" : name;
+    }
+
+    // shutter speed shown as 1/x s
+    function exposureText(us) {
+        if (us <= 0) {
+            return "—";
+        }
+        return us >= 500000 ? (us / 1000000).toFixed(1) + " s" : "1/" + Math.round(1000000 / us);
+    }
+
+    GridLayout {
+        id: buttons
+        columns: root.columns
+        rowSpacing: Kirigami.Units.smallSpacing
+        columnSpacing: Kirigami.Units.smallSpacing
+
+        component SettingButton: QQC2.ToolButton {
+            property bool active: false
+            Layout.preferredHeight: Kirigami.Units.gridUnit * 3.4
+            Layout.preferredWidth: Kirigami.Units.gridUnit * 4.6
+            font.bold: true
+            palette.buttonText: "white"
+            background: Rectangle {
+                radius: Kirigami.Units.smallSpacing
+                color: parent.down ? Qt.rgba(1, 1, 1, 0.35) : (parent.active ? Qt.rgba(0.2, 0.55, 1, 0.65) : Qt.rgba(0, 0, 0, 0.45))
+                border.color: Qt.rgba(1, 1, 1, 0.5)
+            }
+            contentItem: Text {
+                text: parent.text
+                color: "white"
+                font: parent.font
+                horizontalAlignment: Text.AlignHCenter
+                verticalAlignment: Text.AlignVCenter
+                wrapMode: Text.WordWrap
+            }
+        }
+
+        SettingButton {
+            text: root.captureSession.isoManual ? "ISO\n" + root.captureSession.iso : "ISO\nauto " + root.captureSession.iso
+            visible: root.captureSession.aeAvailable
+            active: root.captureSession.isoManual || root.openPanel === "iso"
+            onClicked: root.togglePanel("iso")
+        }
+
+        SettingButton {
+            text: root.captureSession.exposureManual ? "EXP\n" + root.exposureText(root.captureSession.exposureTime) : "EXP\nauto " + root.exposureText(root.captureSession.exposureTime)
+            visible: root.captureSession.aeAvailable
+            active: root.captureSession.exposureManual || root.openPanel === "exp"
+            onClicked: root.togglePanel("exp")
+        }
+
+        SettingButton {
+            text: root.captureSession.focusManual ? "FOCUS\n" + root.captureSession.focusPosition + "%" : "FOCUS\nauto"
+            visible: root.captureSession.focusAvailable
+            active: root.captureSession.focusManual || root.openPanel === "focus"
+            onClicked: root.togglePanel("focus")
+        }
+
+        SettingButton {
+            text: ["FLASH\noff", "FLASH\nauto", "FLASH\non"][root.captureSession.flashMode]
+            visible: root.captureSession.flashAvailable
+            active: root.captureSession.flashMode !== 0
+            onClicked: {
+                root.openPanel = "";
+                root.captureSession.flashMode = (root.captureSession.flashMode + 1) % 3;
+            }
+        }
+    }
+
+    // slider panel under the buttons
+    Rectangle {
+        id: panel
+        visible: root.openPanel !== ""
+        anchors.top: buttons.bottom
+        anchors.topMargin: Kirigami.Units.smallSpacing
+        anchors.left: parent.left
+        width: Math.max(buttons.implicitWidth, Kirigami.Units.gridUnit * 16)
+        implicitHeight: panelLayout.implicitHeight + Kirigami.Units.largeSpacing * 2
+        height: implicitHeight
+        radius: Kirigami.Units.smallSpacing
+        color: Qt.rgba(0, 0, 0, 0.6)
+        border.color: Qt.rgba(1, 1, 1, 0.4)
+
+        RowLayout {
+            id: panelLayout
+            anchors.fill: parent
+            anchors.margins: Kirigami.Units.largeSpacing
+            spacing: Kirigami.Units.largeSpacing
+
+            QQC2.Switch {
+                id: autoSwitch
+                text: i18n("Auto")
+                palette.windowText: "white"
+                checked: root.openPanel === "iso" ? !root.captureSession.isoManual
+                         : root.openPanel === "exp" ? !root.captureSession.exposureManual
+                         : !root.captureSession.focusManual
+                onToggled: {
+                    closeTimer.restart();
+                    if (root.openPanel === "iso") {
+                        if (checked) root.captureSession.setIsoAuto(); else root.captureSession.iso = Math.round(slider.value);
+                    } else if (root.openPanel === "exp") {
+                        if (checked) root.captureSession.setExposureAuto(); else root.captureSession.exposureTime = Math.round(slider.value);
+                    } else if (root.openPanel === "focus") {
+                        if (checked) root.captureSession.setFocusAuto(); else root.captureSession.focusPosition = slider.value;
+                    }
+                }
+            }
+
+            QQC2.Slider {
+                id: slider
+                Layout.fillWidth: true
+                from: root.openPanel === "iso" ? root.captureSession.minIso : root.openPanel === "exp" ? root.captureSession.minExposureTime : 0
+                to: root.openPanel === "iso" ? Math.min(root.captureSession.maxIso, 3200) : root.openPanel === "exp" ? Math.min(root.captureSession.maxExposureTime, 66000) : 100
+                stepSize: root.openPanel === "focus" ? 1 : (root.openPanel === "iso" ? 25 : 250)
+                value: root.openPanel === "iso" ? root.captureSession.iso : root.openPanel === "exp" ? root.captureSession.exposureTime : root.captureSession.focusPosition
+                enabled: !autoSwitch.checked || true
+                onPressedChanged: if (pressed) closeTimer.stop(); else closeTimer.restart()
+                onMoved: {
+                    if (root.openPanel === "iso") root.captureSession.iso = Math.round(value);
+                    else if (root.openPanel === "exp") root.captureSession.exposureTime = Math.round(value);
+                    else if (root.openPanel === "focus") root.captureSession.focusPosition = Math.round(value);
+                }
+            }
+
+            QQC2.Label {
+                Layout.preferredWidth: Kirigami.Units.gridUnit * 4
+                color: "white"
+                horizontalAlignment: Text.AlignRight
+                text: root.openPanel === "iso" ? Math.round(slider.value)
+                      : root.openPanel === "exp" ? root.exposureText(Math.round(slider.value))
+                      : Math.round(slider.value) + "%"
+            }
+        }
+    }
+}
--- a/src/contents/ui/camera/LandscapeControls.qml	1970-01-01 02:00:00.000000000 +0200
+++ b/src/contents/ui/camera/LandscapeControls.qml	2026-10-04 19:44:18.873674008 +0300
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// m52xq: landscape layout - the controls sit in the corners of the screen instead of the middle of the viewfinder.
+//   top left: ISO / EXP / FOCUS / FLASH      top right: microphone (video), switch camera, settings
+//   bottom left: last photo/video, timer      right centre: shutter      bottom right: photo / video
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+
+import org.kde.kirigami as Kirigami
+import org.kde.plasmacamera
+import org.kde.kirigamiaddons.components as Components
+
+Item {
+    id: root
+
+    required property PlasmaCamera camera
+    required property PlasmaCameraManager captureSession
+    required property CaptureController captureController
+
+    required property int captureMode
+    required property bool captureEnabled
+    required property bool switchCameraEnabled
+    required property bool timerButtonEnabled
+    required property bool audioRecordingShown
+
+    signal captureButtonClicked()
+    signal switchCameraRequested()
+    signal timerDurationRequested(duration: int)
+    signal switchCaptureModeRequested(captureMode: int)
+    signal audioToggleRequested()
+
+    readonly property real margin: Kirigami.Units.largeSpacing * 1.5
+
+    Kirigami.Theme.inherit: false
+    Kirigami.Theme.colorSet: Kirigami.Theme.Complementary
+
+    // top left: Megapixels style settings
+    CameraSettingsStrip {
+        anchors.top: parent.top
+        anchors.left: parent.left
+        anchors.margins: root.margin
+        columns: 2
+        camera: root.camera
+        captureSession: root.captureSession
+    }
+
+    // top right: microphone (video), switch camera, KDE settings
+    RowLayout {
+        anchors.top: parent.top
+        anchors.right: parent.right
+        anchors.margins: root.margin
+        spacing: Kirigami.Units.smallSpacing
+
+        QQC2.ToolButton {
+            visible: root.audioRecordingShown
+            icon.name: root.captureSession.audioRecordingEnabled ? "microphone-sensitivity-high-symbolic" : "microphone-sensitivity-muted-symbolic"
+            icon.color: "white"
+            onClicked: root.audioToggleRequested()
+        }
+        QQC2.ToolButton {
+            icon.name: "circular-arrow-shape"
+            icon.color: "white"
+            enabled: root.switchCameraEnabled
+            onClicked: root.switchCameraRequested()
+        }
+        QQC2.ToolButton {
+            icon.name: "settings-configure"
+            icon.color: "white"
+            onClicked: applicationWindow().openSettings()
+        }
+    }
+
+    // bottom left: last photo/video + timer
+    TimerSelectStrip {
+        id: timerStrip
+        shown: false
+        anchors.left: parent.left
+        anchors.bottom: bottomLeft.top
+        anchors.leftMargin: root.margin
+        anchors.bottomMargin: Kirigami.Units.smallSpacing
+        width: Kirigami.Units.gridUnit * 18
+        onTimerDurationRequested: (duration) => root.timerDurationRequested(duration)
+    }
+
+    RowLayout {
+        id: bottomLeft
+        anchors.bottom: parent.bottom
+        anchors.left: parent.left
+        anchors.margins: root.margin
+        spacing: Kirigami.Units.largeSpacing
+
+        Item {
+            implicitWidth: 48
+            implicitHeight: 48
+
+            PreviewArea {
+                id: previewArea
+                anchors.fill: parent
+
+                videoRecorder: root.captureSession.recorder
+                isSavingVideo: root.captureSession.isSavingVideo
+
+                Component.onCompleted: root.captureSession.imageSaved.connect(updatePreview)
+                function updatePreview(_, fileName: string) {
+                    previewArea.imageUrl = "file://" + fileName;
+                }
+
+                Connections {
+                    target: root.captureController
+                    function onPhotoCaptured() { previewArea.setPhotoPreview(); }
+                    function onVideoCaptured() { previewArea.setVideoPreview(); }
+                }
+            }
+
+            Kirigami.Icon {
+                visible: !previewArea.visible
+                anchors.centerIn: parent
+                source: "photo"
+                color: "white"
+                height: Kirigami.Units.gridUnit * 1.3
+            }
+        }
+
+        QQC2.ToolButton {
+            enabled: root.timerButtonEnabled
+            icon.name: "clock"
+            icon.color: "white"
+            onClicked: timerStrip.shown = !timerStrip.shown
+        }
+    }
+
+    // right, vertically centred: shutter
+    CaptureButton {
+        anchors.right: parent.right
+        anchors.rightMargin: root.margin
+        anchors.verticalCenter: parent.verticalCenter
+        captureMode: root.captureMode
+        isRecording: root.captureController.isRecording
+        enabled: root.captureEnabled
+        onClicked: root.captureButtonClicked()
+    }
+
+    // bottom right: photo / video
+    Components.RadioSelector {
+        anchors.bottom: parent.bottom
+        anchors.right: parent.right
+        anchors.margins: root.margin
+        width: Kirigami.Units.gridUnit * 10
+        consistentWidth: true
+
+        Kirigami.Theme.inherit: false
+        Kirigami.Theme.colorSet: Kirigami.Theme.Complementary
+
+        actions: [
+            Kirigami.Action {
+                text: i18n("Photo")
+                icon.name: "camera-photo-symbolic"
+                onTriggered: root.switchCaptureModeRequested(CameraPage.CaptureMode.Photo)
+            },
+            Kirigami.Action {
+                text: i18n("Video")
+                icon.name: "emblem-videos-symbolic"
+                onTriggered: root.switchCaptureModeRequested(CameraPage.CaptureMode.Video)
+            }
+        ]
+    }
+}
