+        for (const auto &camera : m_cameraManager->cameras()) {
+            if (QString::fromStdString(camera->id()).contains(QLatin1String("camera@2d"))) {
+                cameraDeviceId = QString::fromStdString(camera->id());
+            }
+        }
+    }
+    if (m_logical != logical) {
+        m_logical = logical;
+        Q_EMIT logicalModeChanged();
+    }
