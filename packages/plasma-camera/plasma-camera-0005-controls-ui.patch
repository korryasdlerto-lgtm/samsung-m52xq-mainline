+// SPDX-License-Identifier: GPL-2.0-or-later
+// m52xq: automatic and manual exposure for the camera sensors of the Galaxy M52 5G.
+// libcamera's software ISP only offers Contrast/Gamma on this device, so (with its own Agc switched off in the tuning
+// file) the exposure time and the analogue gain are driven here directly through the V4L2 sensor sub-device.
+
+#pragma once
+
+#include <QImage>
+#include <QString>
+
+class SensorAe
+{
+public:
+    SensorAe() = default;
+    ~SensorAe();
+
+    // Called with the id of the active libcamera camera.
+    void setCameraId(const QString &cameraId);
+    // Called with every viewfinder frame.
+    void processFrame(const QImage &image);
+
+    bool available() const { return m_fd >= 0; }
+
+    // ISO 100 = 1x analogue gain
+    int iso() const;
+    int minIso() const;
+    int maxIso() const;
+    bool isoManual() const { return m_isoManual; }
+    void setIso(int iso);
+    void setIsoAuto();
+
+    // microseconds
+    int exposureTime() const;
+    int minExposureTime() const;
+    int maxExposureTime() const;
+    bool exposureManual() const { return m_expManual; }
+    void setExposureTime(int us);
+    void setExposureAuto();
+
+private:
+    enum class GainModel {
+        Linear, // multiplier = raw / unity
+        Imx258, // multiplier = 512 / (512 - raw)
+    };
+
+    void close();
+    bool open(const QString &sensorName);
+    bool getCtrl(unsigned id, int *value) const;
+    bool setCtrl(unsigned id, int value);
+    int gainToRaw(double multiplier) const;
+    double rawToGain(int raw) const;
+    double lineUs() const;
+    void apply(double exposureUs, double multiplier);
+
+    int m_fd = -1;
+    QString m_cameraId;
+    GainModel m_model = GainModel::Linear;
+    int m_unity = 64;
+    int m_expMin = 1, m_expMax = 1, m_gainMin = 0, m_gainMax = 0;
+    double m_lineUs = 10.0;
+    int m_expRaw = 0, m_gainRaw = 0;
+    bool m_isoManual = false;
+    bool m_expManual = false;
+    int m_wait = 0;
+    int m_frame = 0;
+};
