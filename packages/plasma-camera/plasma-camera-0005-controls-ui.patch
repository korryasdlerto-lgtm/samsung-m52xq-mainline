+SensorAe::~SensorAe()
+{
+    close();
+}
+
+void SensorAe::close()
+{
+    if (m_fd >= 0) {
+        ::close(m_fd);
+        m_fd = -1;
+    }
+}
+
+bool SensorAe::getCtrl(unsigned id, int *value) const
+{
+    v4l2_control c{id, 0};
+    if (::ioctl(m_fd, VIDIOC_G_CTRL, &c) < 0) {
+        return false;
+    }
+    *value = c.value;
+    return true;
+}
+
+bool SensorAe::setCtrl(unsigned id, int value)
+{
+    v4l2_control c{id, value};
+    return ::ioctl(m_fd, VIDIOC_S_CTRL, &c) == 0;
+}
+
+bool SensorAe::open(const QString &sensorName)
+{
+    const QDir dir(QStringLiteral("/sys/class/video4linux"));
+    for (const QString &entry : dir.entryList({QStringLiteral("v4l-subdev*")}, QDir::Dirs | QDir::NoDotAndDotDot)) {
+        QFile nameFile(dir.filePath(entry + QStringLiteral("/name")));
+        if (!nameFile.open(QIODevice::ReadOnly) || !nameFile.readAll().startsWith(sensorName.toLatin1())) {
+            continue;
+        }
+        m_fd = ::open(QFile::encodeName(QStringLiteral("/dev/") + entry).constData(), O_RDWR | O_CLOEXEC);
+        if (m_fd < 0) {
+            qWarning() << "SensorAe: cannot open /dev/" << entry;
+            return false;
+        }
+        v4l2_queryctrl q{};
+        q.id = V4L2_CID_EXPOSURE;
+        if (::ioctl(m_fd, VIDIOC_QUERYCTRL, &q) < 0) {
+            close();
+            return false;
+        }
+        m_expMin = q.minimum;
+        m_expMax = q.maximum;
+        q = {};
+        q.id = V4L2_CID_ANALOGUE_GAIN;
+        if (::ioctl(m_fd, VIDIOC_QUERYCTRL, &q) < 0) {
+            close();
+            return false;
+        }
+        m_gainMin = q.minimum;
+        m_gainMax = q.maximum;
+
+        // line time = (active width + horizontal blanking) / pixel rate
+        int hblank = 0;
+        getCtrl(V4L2_CID_HBLANK, &hblank);
+        v4l2_ext_control ec{};
+        ec.id = V4L2_CID_PIXEL_RATE;
+        v4l2_ext_controls ecs{};
+        ecs.ctrl_class = V4L2_CTRL_ID2WHICH(V4L2_CID_PIXEL_RATE);
+        ecs.count = 1;
+        ecs.controls = &ec;
+        long long pixelRate = 0;
+        if (::ioctl(m_fd, VIDIOC_G_EXT_CTRLS, &ecs) == 0) {
+            pixelRate = ec.value64;
+        }
+        v4l2_subdev_format fmt{};
+        fmt.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+        fmt.pad = 0;
+        int width = 0;
+        if (::ioctl(m_fd, VIDIOC_SUBDEV_G_FMT, &fmt) == 0) {
+            width = fmt.format.width;
+        }
+        m_lineUs = (pixelRate > 0 && width > 0) ? (double(width) + hblank) / double(pixelRate) * 1e6 : 10.0;
+        qInfo() << "SensorAe: using" << entry << "exposure" << m_expMin << "-" << m_expMax << "gain" << m_gainMin << "-" << m_gainMax << "line"
+                << m_lineUs << "us";
+        getCtrl(V4L2_CID_EXPOSURE, &m_expRaw);
+        getCtrl(V4L2_CID_ANALOGUE_GAIN, &m_gainRaw);
+        return true;
+    }
+    return false;
+}
+
+void SensorAe::setCameraId(const QString &cameraId)
+{
+    if (cameraId == m_cameraId) {
+        return;
+    }
+    m_cameraId = cameraId;
+    close();
+    for (const SensorInfo &s : kSensors) {
+        if (cameraId.contains(QLatin1String(s.camera))) {
+            m_model = s.imx258 ? GainModel::Imx258 : GainModel::Linear;
+            m_unity = s.unity;
+            if (open(QLatin1String(s.name))) {
+                m_wait = kWaitFrames;
+                m_frame = 0;
+            }
+            return;
+        }
+    }
+}
+
+double SensorAe::rawToGain(int raw) const
+{
+    if (m_model == GainModel::Imx258) {
+        return 512.0 / (512.0 - std::min(raw, 500));
+    }
+    return double(raw) / m_unity;
+}
+
+int SensorAe::gainToRaw(double multiplier) const
+{
+    int raw;
+    if (m_model == GainModel::Imx258) {
+        raw = int(std::lround(512.0 - 512.0 / std::max(multiplier, 1.0)));
+    } else {
+        raw = int(std::lround(multiplier * m_unity));
+    }
+    return std::clamp(raw, m_gainMin, m_gainMax);
+}
+
+double SensorAe::lineUs() const
+{
+    return m_lineUs;
+}
+
+int SensorAe::iso() const
+{
+    return int(std::lround(rawToGain(m_gainRaw) * 100.0));
+}
+
+int SensorAe::minIso() const
+{
+    return int(std::lround(rawToGain(m_gainMin) * 100.0));
+}
+
+int SensorAe::maxIso() const
+{
+    return int(std::lround(rawToGain(m_gainMax) * 100.0));
+}
+
+int SensorAe::exposureTime() const
+{
+    return int(std::lround(m_expRaw * lineUs()));
+}
+
+int SensorAe::minExposureTime() const
+{
+    return int(std::lround(m_expMin * lineUs()));
+}
+
+int SensorAe::maxExposureTime() const
+{
+    return int(std::lround(m_expMax * lineUs()));
+}
+
+void SensorAe::apply(double exposureUs, double multiplier)
+{
+    const int expRaw = std::clamp(int(std::lround(exposureUs / lineUs())), m_expMin, m_expMax);
+    const int gainRaw = gainToRaw(multiplier);
+    if (expRaw != m_expRaw && setCtrl(V4L2_CID_EXPOSURE, expRaw)) {
+        m_expRaw = expRaw;
+    }
+    if (gainRaw != m_gainRaw && setCtrl(V4L2_CID_ANALOGUE_GAIN, gainRaw)) {
+        m_gainRaw = gainRaw;
+    }
+    m_wait = kWaitFrames;
+}
+
+void SensorAe::setIso(int iso)
+{
+    if (m_fd < 0) {
+        return;
+    }
+    m_isoManual = true;
+    const int raw = gainToRaw(iso / 100.0);
+    if (setCtrl(V4L2_CID_ANALOGUE_GAIN, raw)) {
+        m_gainRaw = raw;
+    }
+    m_wait = kWaitFrames;
+}
+
+void SensorAe::setIsoAuto()
+{
+    m_isoManual = false;
+}
+
+void SensorAe::setExposureTime(int us)
+{
+    if (m_fd < 0) {
+        return;
+    }
+    m_expManual = true;
+    const int raw = std::clamp(int(std::lround(us / lineUs())), m_expMin, m_expMax);
+    if (setCtrl(V4L2_CID_EXPOSURE, raw)) {
+        m_expRaw = raw;
+    }
+    m_wait = kWaitFrames;
+}
+
+void SensorAe::setExposureAuto()
+{
+    m_expManual = false;
+}
+
+void SensorAe::processFrame(const QImage &image)
+{
+    if (m_fd < 0 || image.isNull() || (m_isoManual && m_expManual)) {
+        return;
+    }
+    if (m_wait > 0) {
+        --m_wait;
+        return;
+    }
+    if (++m_frame % 2) {
+        return;
+    }
+
+    // luma histogram of a sparse grid (bytes 0..2 are R,G,B or B,G,R: the weights are symmetric)
+    const int w = image.width(), h = image.height();
+    if (image.depth() != 32 || w < 32 || h < 32) {
+        return;
+    }
+    const int stepX = std::max(8, w / 160), stepY = std::max(8, h / 120);
+    quint64 sum = 0, count = 0, clipped = 0;
+    for (int y = stepY / 2; y < h; y += stepY) {
+        const uchar *row = image.constScanLine(y);
+        for (int x = stepX / 2; x < w; x += stepX) {
+            const uchar *p = row + x * 4;
+            const unsigned luma = (p[0] + 2u * p[1] + p[2]) >> 2;
+            sum += luma;
+            clipped += luma >= kClipLuma;
+            ++count;
+        }
+    }
+    if (!count) {
+        return;
+    }
+    const double mean = std::max(1.0, double(sum) / count);
+    const double clipFraction = double(clipped) / count;
+
+    // lower the target when highlights clip (no blown-out skies), never raise it above the base target
+    double target = kTargetMean;
+    if (clipFraction > kClipFractionLimit) {
+        target *= std::max(0.55, 1.0 - (clipFraction - kClipFractionLimit) * 5.0);
+    }
+    double ratio = target / mean;
+    // damping, and a dead band to avoid hunting
+    ratio = std::pow(ratio, 0.55);
+    if (std::abs(ratio - 1.0) < 0.06 && clipFraction <= kClipFractionLimit) {
+        return;
+    }
+    ratio = std::clamp(ratio, 0.5, 2.0);
+
+    const double curExp = m_expRaw * lineUs();
+    const double curGain = rawToGain(m_gainRaw);
+    const double total = curExp * curGain * ratio;
+    const double minGain = rawToGain(m_gainMin);
+    const double maxGain = std::min(rawToGain(m_gainMax), kMaxAutoMultiplier);
+    const double minExp = m_expMin * lineUs();
+    const double maxExp = std::min(m_expMax * lineUs(), kMaxAutoExposureUs);
+
+    double exposure = curExp, gain = curGain;
+    if (m_expManual) {
+        gain = std::clamp(total / curExp, minGain, maxGain);
+    } else if (m_isoManual) {
+        exposure = std::clamp(total / curGain, minExp, maxExp);
+    } else {
+        // exposure first (low noise), gain only when the exposure is at its limit; on the way down gain first
+        exposure = std::clamp(total / minGain, minExp, maxExp);
+        gain = std::clamp(total / exposure, minGain, maxGain);
+    }
+    apply(exposure, gain);
+}
