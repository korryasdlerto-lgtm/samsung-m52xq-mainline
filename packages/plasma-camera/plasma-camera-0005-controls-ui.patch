+int PlasmaCameraManager::ambientLux() const
+{
+    const QLightReading *r = const_cast<QLightSensor &>(m_lightSensor).reading();
+    return r ? int(r->lux()) : -1;
+}
+
+// m52xq: flash on, or in auto mode only when the ambient light sensor reports a dark room
+bool PlasmaCameraManager::flashWanted() const
+{
+    if (m_flashMode == 2) {
+        return true;
+    }
+    if (m_flashMode == 1) {
+        const int lux = ambientLux();
+        qInfo() << "Flash auto: ambient light" << lux << "lux";
+        return lux >= 0 && lux < 40;
+    }
+    return false;
+}
+
+int PlasmaCameraManager::flashMaxLevel() const
+{
+    QFile f(QString::fromLatin1(kFlashLed) + QStringLiteral("/max_brightness"));
+    if (f.open(QIODevice::ReadOnly)) {
+        const int v = f.readAll().trimmed().toInt();
+        if (v > 0) {
+            return v;
+        }
+    }
+    return 1;
+}
+
+void PlasmaCameraManager::setFlashLed(int level)
+{
+    QFile f(QString::fromLatin1(kFlashLed) + QStringLiteral("/brightness"));
+    if (f.open(QIODevice::WriteOnly)) {
+        f.write(QByteArray::number(level));
+    }
+}
