+qreal PlasmaCameraManager::zoom() const
+{
+    return m_zoom;
+}
+
+void PlasmaCameraManager::setZoom(qreal zoom)
+{
+    zoom = qBound<qreal>(1.0, zoom, 8.0);
+    if (qFuzzyCompare(zoom, m_zoom)) {
+        return;
+    }
+    m_zoom = zoom;
+    Q_EMIT zoomChanged();
+}
+
+// m52xq: digital zoom (pinch in the viewfinder): the centre 1/zoom of the frame, used for the viewfinder, photos and video.
+QImage PlasmaCameraManager::applyZoom(const QImage &image) const
+{
+    if (image.isNull() || m_zoom <= 1.001) {
+        return image;
+    }
+    const int w = qMax(16, static_cast<int>(image.width() / m_zoom) & ~1);
+    const int h = qMax(16, static_cast<int>(image.height() / m_zoom) & ~1);
+    const int x = ((image.width() - w) / 2) & ~1;
+    const int y = ((image.height() - h) / 2) & ~1;
+    return image.copy(x, y, w, h);
+}
