+void PlasmaCameraManager::focusAt(qreal x, qreal y)
+{
+    if (!m_plasmaCamera || !m_autofocus.available()) {
+        return;
+    }
+    // the shown picture = the frame rotated clockwise by the viewfinder angle, then mirrored (see the frame code above)
+    int deg = (static_cast<int>(outputOrientationDegrees()) % 360 + 360) % 360;
+    if (m_plasmaCamera->mirrorOutput()) {
+        deg = (180 - deg + 360) % 360;
+        x = 1.0 - x;
+    }
+    qreal u = x, v = y;
+    switch (deg) {
+    case 90: // shown (1 - v, u)
+        u = y;
+        v = 1.0 - x;
+        break;
+    case 180:
+        u = 1.0 - x;
+        v = 1.0 - y;
+        break;
+    case 270: // shown (v, 1 - u)
+        u = 1.0 - y;
+        v = x;
+        break;
+    default:
+        break;
+    }
+    // the viewfinder shows the middle 1/z of the frame (applyZoom), the autofocus gets the whole frame
+    const qreal z = effectiveZoom();
+    u = 0.5 + (u - 0.5) / z;
+    v = 0.5 + (v - 0.5) / z;
+    m_autofocus.focusAt(u, v);
+}
+
 void PlasmaCameraManager::setFocusAuto()
 {
     m_autofocus.setAuto();
