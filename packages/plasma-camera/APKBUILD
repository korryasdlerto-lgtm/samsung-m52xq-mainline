# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=plasma-camera
pkgver=2.1.1
pkgrel=58
pkgdesc="Camera application for Plasma Mobile"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
options="!check"
url="https://invent.kde.org/plasma-mobile/plasma-camera"
license="GPL-3.0-or-later AND BSD-3-Clause"
depends="
	gst-plugins-bad
	gst-plugins-good
	kirigami
	kirigami-addons
	libcamera
	qt6-qtmultimedia
	qt6-qtsensors
	"
makedepends="
	extra-cmake-modules
	libepoxy-dev
	libjpeg-turbo-dev
	kcoreaddons-dev
	linux-headers
	ki18n-dev
	kirigami-dev
	libcamera-dev
	libkexiv2-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtmultimedia-dev
	qt6-qtsensors-dev
	qt6-qtsvg-dev
	samurai
	"
checkdepends="appstream"
subpackages="$pkgname-lang"
source="https://download.kde.org/stable/plasma-camera/plasma-camera-$pkgver.tar.xz
	plasma-camera-0001-viewfinder-follows-orientation.patch
	plasma-camera-0002-lens-autofocus.patch
	plasma-camera-0003-video-rotation.patch
	plasma-camera-0004-pinch-zoom.patch
	plasma-camera-0005-controls-ui.patch
	plasma-camera-0006-viewfinder-frame-throttle.patch
	plasma-camera-0007-m52xq-start-order-digital-gain.patch
	plasma-camera-0008-m52xq-rear-no-cap-learning-memory-v2.patch
	plasma-camera-0009-m52xq-frame-copy-drop-stale-camera.patch
	plasma-camera-0010-m52xq-frame-camera-id-dark-frame-log.patch
	plasma-camera-0011-m52xq-sensorae-gain-x64-vblank-reset-fast-dark.patch
	plasma-camera-0012-m52xq-viewfinder-max-20mp.patch
	plasma-camera-0013-m52xq-tap-to-focus.patch
	plasma-camera-0014-m52xq-photo-resolution-jpeg92.patch
	plasma-camera-0015-m52xq-full-resolution-raw-photo.patch
	plasma-camera-0016-m52xq-video-encoder-backpressure.patch
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	# The contrast autofocus drives the lens subdevice (Galaxy M52 5G: Fitipower FP5529)
	mkdir -p "$pkgdir"/usr/lib/udev/rules.d
	echo 'SUBSYSTEM=="video4linux", ATTR{name}=="fp5529*", MODE="0666"' > "$pkgdir"/usr/lib/udev/rules.d/99-m52xq-lens.rules
}

