+int PlasmaCameraManager::photoScale() const
+{
+    return m_photoScale;
+}
+
+void PlasmaCameraManager::setPhotoScale(int scale)
+{
+    scale = qBound(20, scale, 100);
+    if (scale == m_photoScale) {
+        return;
+    }
+    m_photoScale = scale;
+    CameraSettings::self()->setPhotoScale(scale);
+    CameraSettings::self()->save();
+    Q_EMIT photoScaleChanged();
+}
+
+QString PlasmaCameraManager::photoSizeLabel(int scale) const
+{
+    if (m_currentFrame.isNull()) {
+        return QStringLiteral("%1 %").arg(scale);
+    }
+    const int w = (m_currentFrame.width() * scale / 100) & ~1;
+    const int h = (m_currentFrame.height() * scale / 100) & ~1;
+    const double mp = double(w) * h / 1e6;
+    return QStringLiteral("%1 × %2 (%3 MP)").arg(w).arg(h).arg(mp >= 10 ? QString::number(qRound(mp)) : QString::number(mp, 'f', 1));
+}
