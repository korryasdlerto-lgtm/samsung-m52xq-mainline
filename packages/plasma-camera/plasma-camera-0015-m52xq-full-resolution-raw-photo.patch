+
+void PlasmaCameraManager::processRawCapture(const QByteArray &data, int width, int height, int stride, const QString &cfa,
+                                            const QString &cameraId)
+{
+    if (data.isEmpty() || width <= 0 || height <= 0 || cfa.size() != 4 || data.size() < qsizetype(stride) * height) {
+        qWarning() << "m52xq: no raw frame, taking the photo from the viewfinder stream";
+        m_plasmaCamera->captureImage();
+        return;
+    }
+    QDateTime now = QDateTime::currentDateTime();
+    if ((m_filenamePattern == 1) || (m_filenamePattern == 2)) {
+        m_imageCaptureFileName = now.toString(QStringLiteral("yyyyMMddHHmmss"));
+    }
+    const QString fileName = PlasmaLibcameraUtils::generateFileName(m_imageCaptureFileName, QLatin1String("jpg"), m_filenamePattern, m_outputPath);
+
+    // EXIF orientation of the still path (mirror vertically, then rotate clockwise by the output orientation)
+    const int deg = (static_cast<int>(outputOrientationDegrees()) % 360 + 360) % 360;
+    const bool mirror = m_plasmaCamera->mirrorOutput();
+    int exif = 1;
+    if (!mirror) {
+        exif = deg == 90 ? 6 : (deg == 180 ? 3 : (deg == 270 ? 8 : 1));
+    } else {
+        exif = deg == 90 ? 5 : (deg == 180 ? 2 : (deg == 270 ? 7 : 4));
+    }
+    // how dark the scene is (sensor gain towards its maximum, digital gain on top): stronger noise reduction
+    const double isoFrac = m_ae.maxIso() > 0 ? double(m_ae.iso()) / m_ae.maxIso() : 0.0;
+    const float dark = float(qBound(0.0, (isoFrac - 0.25) / 0.65 + (m_ae.digitalGain() - 1.0) * 0.25, 1.0));
+    const bool mainCam = cameraId.contains(QLatin1String("camera@2d"));
+    const bool front = cameraId.contains(QLatin1String("camera@1a"));
+    const int captureNum = m_imageCaptureNum;
+    // after the re-mosaic the main camera frame is a plain GRBG Bayer pattern
+    const QByteArray cfaBytes = (mainCam ? QStringLiteral("GRBG") : cfa).toLatin1();
+
+    m_developPool.setMaxThreadCount(1);
+    m_developPool.setExpiryTimeout(-1);
+    m_developPool.start([this, data, width, height, stride, cfaBytes, mainCam, exif, dark, front, fileName, captureNum]() {
+        const bool ok = m52xq_raw_develop(reinterpret_cast<const uint8_t *>(data.constData()), width, height, stride,
+                                          cfaBytes.constData(), mainCam, exif, dark, front, fileName.toLocal8Bit().constData());
+        if (ok) {
+            writeExifData(fileName);
+        }
+        QMetaObject::invokeMethod(this, [this, ok, fileName, captureNum]() {
+            setFlashLed(0);
+            if (ok) {
+                Q_EMIT imageSaved(captureNum, fileName);
+            } else {
+                setError(captureNum, ResourceError, QStringLiteral("Could not develop the full-resolution photo"));
+                m_plasmaCamera->captureImage();
+            }
+        }, Qt::QueuedConnection);
+    });
+}
