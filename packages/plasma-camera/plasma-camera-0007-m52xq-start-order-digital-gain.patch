+// m52xq r18: the last converged exposure, gain and digital gain of every camera: the next start (or camera switch)
+// begins there instead of in the dark with the sensor defaults and the stairs of a search from scratch
+QString SensorAe::memoryPath() const
+{
+    QString token = m_cameraId;
+    const int at = token.lastIndexOf(QLatin1Char('@'));
+    token = at >= 0 ? token.mid(at + 1) : QStringLiteral("camera");
+    QString base = qEnvironmentVariable("XDG_CACHE_HOME");
+    if (base.isEmpty()) {
+        base = QDir::homePath() + QStringLiteral("/.cache");
+    }
+    return base + QStringLiteral("/plasma-camera-3a-") + token;
+}
+
+void SensorAe::saveMemory()
+{
+    QFile f(memoryPath());
+    if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        f.write(QStringLiteral("exp=%1 gain=%2 dg=%3 cap=%4\n").arg(m_expRaw).arg(m_gainRaw).arg(m_digital, 0, 'f', 4).arg(m_expCapUs < 1e8 ? m_expCapUs : 0.0, 0, 'f', 1).toUtf8());
+    }
+    m_saved = true;
+}
+
+void SensorAe::restoreMemory()
+{
+    QFile f(memoryPath());
+    if (!f.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    int exp = 0, gain = 0;
+    double dg = 1.0, cap = 0.0;
+    const int fields = std::sscanf(f.readAll().constData(), "exp=%d gain=%d dg=%lf cap=%lf", &exp, &gain, &dg, &cap);
+    if (fields < 3) {
+        return;
+    }
+    if (fields == 4 && cap > 0.0) {
+        m_expCapUs = cap;
+    }
+    exp = std::clamp(exp, m_expMin, m_expMax);
+    gain = std::clamp(gain, m_gainMin, m_gainMax);
+    if (setCtrl(V4L2_CID_EXPOSURE, exp)) {
+        m_expRaw = exp;
+    }
+    if (setCtrl(V4L2_CID_ANALOGUE_GAIN, gain)) {
+        m_gainRaw = gain;
+    }
+    m_digital = m_digitalShown = std::clamp(dg, 1.0, m_maxDigital);
+    m_wait = kWaitFrames + 1;
+    qInfo() << "SensorAe: restored exposure" << m_expRaw << "gain" << m_gainRaw << "digital" << m_digital;
+}
+
+void SensorAe::requeryExposureRange()
+{
+    v4l2_queryctrl q{};
+    q.id = V4L2_CID_EXPOSURE;
+    if (::ioctl(m_fd, VIDIOC_QUERYCTRL, &q) == 0) {
+        m_expMax = q.maximum;
+    }
+}
