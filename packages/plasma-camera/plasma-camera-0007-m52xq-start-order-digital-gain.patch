+// m52xq r22: lengthen (or shorten) the frame of a dim camera. Returns true when the frame length was changed.
+bool SensorAe::extendFrame(bool longer)
+{
+    if (!m_extendable || m_fd < 0) {
+        return false;
+    }
+    int target = m_vblank;
+    if (longer) {
+        // the longest frame whose exposure range does not exceed kMaxExtendedExposureUs
+        const int limit = std::min(m_vblankMax, m_vblankDefault + int(kMaxExtendedExposureUs / lineUs()) - m_expMaxDefault);
+        target = std::min(limit, std::max(m_vblank + 8, int(m_vblank * 1.35)));
+    } else {
+        target = std::max(m_vblankDefault, int(m_vblank / 1.35));
+    }
+    target = std::clamp(target, m_vblankMin, m_vblankMax);
+    if (target == m_vblank || !setCtrl(V4L2_CID_VBLANK, target)) {
+        return false;
+    }
+    m_vblank = target;
+    requeryExposureRange(); // the exposure maximum follows the frame length
+    m_maxAutoExpUs = std::min(m_expMax * lineUs(), m_vblank > m_vblankDefault ? kMaxExtendedExposureUs : kMaxAutoExposureUs);
+    qInfo() << "SensorAe: frame lengthened, vblank" << m_vblank << "exposure maximum" << m_expMax << "lines";
+    m_wait = kWaitFrames + 2;
+    m_sinceApply = 0;
+    return true;
+}
