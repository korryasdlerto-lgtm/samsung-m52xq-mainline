 // m52xq: digital zoom (pinch in the viewfinder): the centre 1/zoom of the frame, used for the viewfinder, photos and video.
+// m52xq r17: digital gain for dark scenes (the sensor is at its exposure and analogue gain limits): a multiplication of the
+// gamma coded colour channels, equal to gain^(1/2.2) in linear light. Used for the viewfinder, photos and video.
+static QImage applyDigitalGain(const QImage &image, double gain, double wb0 = 1.0, double wb2 = 1.0)
+{
+    if (image.isNull() || image.depth() != 32 || (gain < 1.02 && std::abs(wb0 - 1.0) < 0.03 && std::abs(wb2 - 1.0) < 0.03)) {
+        return image;
+    }
+    QImage out = image; // implicit sharing: detach (copy) before writing
+    out.detach();
+    const double k = std::pow(std::max(gain, 1.0), 1.0 / 2.2);
+    quint8 lut0[256], lut1[256], lut2[256];
+    for (int i = 0; i < 256; ++i) {
+        lut0[i] = quint8(qMin(255.0, i * k * wb0 + 0.5));
+        lut1[i] = quint8(qMin(255.0, i * k + 0.5));
+        lut2[i] = quint8(qMin(255.0, i * k * wb2 + 0.5));
+    }
+    const int w = out.width(), h = out.height();
+    for (int y = 0; y < h; ++y) {
+        uchar *p = out.scanLine(y);
+        for (int x = 0; x < w; ++x, p += 4) {
+            p[0] = lut0[p[0]];
+            p[1] = lut1[p[1]];
+            p[2] = lut2[p[2]];
+        }
+    }
+    return out;
+}
