@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "lensautofocus.h"
+
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <algorithm>
+#include <cmath>
+#include <fcntl.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+namespace
+{
+// Factory calibration of the rear main camera (EEPROM): 335 = infinity, 621 = macro.
+constexpr int kInfinity = 335;
+constexpr int kMacro = 621;
+// Frames to wait after moving the lens (VCM settling + pipeline latency).
+constexpr int kSettleFrames = 4;
+// Re-run the search when the sharpness fell below this fraction of the reference for kLowFramesToRetrigger frames.
+constexpr double kLowRatio = 0.6;
+constexpr int kLowFramesToRetrigger = 6;
+constexpr double kMeanChange = 0.35;
+}
+
+LensAutofocus::~LensAutofocus()
+{
+    closeLens();
+}
+
+void LensAutofocus::closeLens()
+{
+    if (m_fd >= 0) {
+        ::close(m_fd);
+        m_fd = -1;
+    }
+}
+
+bool LensAutofocus::openLens()
+{
+    if (m_fd >= 0) {
+        return true;
+    }
+    const QDir dir(QStringLiteral("/sys/class/video4linux"));
+    for (const QString &entry : dir.entryList({QStringLiteral("v4l-subdev*")}, QDir::Dirs | QDir::NoDotAndDotDot)) {
+        QFile nameFile(dir.filePath(entry + QStringLiteral("/name")));
+        if (!nameFile.open(QIODevice::ReadOnly)) {
+            continue;
+        }
+        if (!nameFile.readAll().startsWith("fp5529")) {
+            continue;
+        }
+        m_fd = ::open(QFile::encodeName(QStringLiteral("/dev/") + entry).constData(), O_RDWR | O_CLOEXEC);
+        if (m_fd >= 0) {
+            qInfo() << "Autofocus: using lens" << entry;
+            return true;
+        }
+        qWarning() << "Autofocus: cannot open /dev/" << entry;
+    }
+    return false;
+}
+
+bool LensAutofocus::setPosition(int position)
+{
+    if (m_fd < 0) {
+        return false;
+    }
+    position = std::clamp(position, 0, 1023);
+    v4l2_control ctrl{V4L2_CID_FOCUS_ABSOLUTE, position};
+    if (::ioctl(m_fd, VIDIOC_S_CTRL, &ctrl) < 0) {
+        qWarning() << "Autofocus: VIDIOC_S_CTRL failed";
+        return false;
+    }
+    m_current = position;
+    return true;
+}
+
+void LensAutofocus::setCameraId(const QString &cameraId)
+{
+    if (cameraId == m_cameraId) {
+        return;
+    }
+    m_cameraId = cameraId;
+    // The lens belongs to the rear main camera (sensor camera@2d); override with M52XQ_AF_CAMERA if needed.
+    const QString match = qEnvironmentVariableIsSet("M52XQ_AF_CAMERA") ? qEnvironmentVariable("M52XQ_AF_CAMERA") : QStringLiteral("camera@2d");
+    if (!cameraId.contains(match) || !openLens()) {
+        m_state = State::Disabled;
+        return;
+    }
+    startScan();
+}
+
+void LensAutofocus::trigger()
+{
+    if (m_state != State::Disabled) {
+        startScan();
+    }
+}
+
+void LensAutofocus::startScan()
+{
+    m_positions = {kInfinity, kInfinity + 15, kInfinity + 35, kInfinity + 60, kInfinity + 95, kInfinity + 140, kInfinity + 200, kMacro};
+    m_fine = false;
+    m_index = 0;
+    m_scores.assign(m_positions.size(), 0.0);
+    m_lowFrames = 0;
+    setPosition(m_positions[0]);
+    m_settleFrames = kSettleFrames;
+    m_state = State::Settling;
+}
+
+double LensAutofocus::sharpness(const QImage &image, double *mean) const
+{
+    // Gradient energy of 4x4 block averages of the green channel in the central region, normalised by the squared mean.
+    const int width = image.width();
+    const int height = image.height();
+    if (width < 64 || height < 64 || image.depth() != 32) {
+        *mean = 0.0;
+        return 0.0;
+    }
+    const int roiW = (width * 2 / 5) & ~3;
+    const int roiH = (height * 2 / 5) & ~3;
+    const int x0 = ((width - roiW) / 2) & ~3;
+    const int y0 = ((height - roiH) / 2) & ~3;
+    const int bw = roiW / 4;
+    const int bh = roiH / 4;
+
+    std::vector<float> blocks(static_cast<size_t>(bw) * bh);
+    double sum = 0.0;
+    for (int by = 0; by < bh; ++by) {
+        float *out = &blocks[static_cast<size_t>(by) * bw];
+        for (int bx = 0; bx < bw; ++bx) {
+            int acc = 0;
+            for (int j = 0; j < 4; ++j) {
+                const uchar *line = image.constScanLine(y0 + by * 4 + j) + (x0 + bx * 4) * 4 + 1;
+                acc += line[0] + line[4] + line[8] + line[12];
+            }
+            out[bx] = acc / 16.0f;
+            sum += out[bx];
+        }
+    }
+    const double m = sum / (static_cast<double>(bw) * bh);
+    double energy = 0.0;
+    for (int by = 0; by < bh - 1; ++by) {
+        const float *row = &blocks[static_cast<size_t>(by) * bw];
+        const float *next = row + bw;
+        for (int bx = 0; bx < bw - 1; ++bx) {
+            const double gx = row[bx + 1] - row[bx];
+            const double gy = next[bx] - row[bx];
+            energy += gx * gx + gy * gy;
+        }
+    }
+    *mean = m;
+    return energy / (static_cast<double>(bw) * bh) / std::max(m * m, 1.0) * 1000.0;
+}
+
+void LensAutofocus::nextStep()
+{
+    ++m_index;
+    if (m_index < m_positions.size()) {
+        setPosition(m_positions[m_index]);
+        m_settleFrames = kSettleFrames;
+        m_state = State::Settling;
+        return;
+    }
+
+    // Search finished: pick the best position.
+    const auto best = std::max_element(m_scores.begin(), m_scores.end());
+    m_bestPosition = m_positions[static_cast<size_t>(best - m_scores.begin())];
+
+    if (!m_fine) {
+        // Refine around the coarse maximum.
+        m_fine = true;
+        m_positions.clear();
+        for (int delta = -24; delta <= 24; delta += 8) {
+            const int p = m_bestPosition + delta;
+            if (p >= kInfinity - 10 && p <= kMacro) {
+                m_positions.push_back(p);
+            }
+        }
+        m_index = 0;
+        m_scores.assign(m_positions.size(), 0.0);
+        setPosition(m_positions[0]);
+        m_settleFrames = kSettleFrames;
+        m_state = State::Settling;
+        return;
+    }
+
+    setPosition(m_bestPosition);
+    m_reference = 0.0;
+    m_settleFrames = kSettleFrames;
+    m_state = State::Holding;
+    qInfo() << "Autofocus: locked at" << m_bestPosition;
+}
+
+void LensAutofocus::processFrame(const QImage &image)
+{
+    if (m_state == State::Disabled || image.isNull()) {
+        return;
+    }
+
+    if (m_settleFrames > 0 && m_state != State::Scanning) {
+        --m_settleFrames;
+        if (m_settleFrames > 0) {
+            return;
+        }
+        if (m_state == State::Settling) {
+            m_state = State::Scanning;
+        }
+    }
+
+    double mean = 0.0;
+    const double score = sharpness(image, &mean);
+
+    switch (m_state) {
+    case State::Scanning:
+        m_scores[m_index] = score;
+        nextStep();
+        break;
+    case State::Holding:
+        if (m_reference <= 0.0) {
+            m_reference = score;
+            m_referenceMean = mean;
+            m_lowFrames = 0;
+            break;
+        }
+        if (score < m_reference * kLowRatio || std::abs(mean - m_referenceMean) > m_referenceMean * kMeanChange) {
+            if (++m_lowFrames >= kLowFramesToRetrigger) {
+                qInfo() << "Autofocus: scene changed, searching again";
+                startScan();
+            }
+        } else {
+            m_lowFrames = 0;
+        }
+        break;
+    default:
+        break;
+    }
+}
diff -urN a2/src/lensautofocus.h b2/src/lensautofocus.h
