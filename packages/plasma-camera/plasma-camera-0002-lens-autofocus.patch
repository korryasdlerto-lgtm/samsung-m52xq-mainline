@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Contrast autofocus for voice-coil lenses exposed as V4L2 subdevices (Galaxy M52 5G, Fitipower FP5529).
+
+#pragma once
+
+#include <QImage>
+#include <QString>
+#include <vector>
+
+class LensAutofocus
+{
+public:
+    LensAutofocus() = default;
+    ~LensAutofocus();
+
+    // Called with the id of the active libcamera camera; enables the autofocus only for the camera that has the lens.
+    void setCameraId(const QString &cameraId);
+    // Called with every viewfinder frame.
+    void processFrame(const QImage &image);
+    // Restart the focus search.
+    void trigger();
+
+private:
+    enum class State {
+        Disabled,
+        Settling,
+        Scanning,
+        Holding,
+    };
+
+    bool openLens();
+    void closeLens();
+    bool setPosition(int position);
+    double sharpness(const QImage &image, double *mean) const;
+    void startScan();
+    void nextStep();
+
+    State m_state = State::Disabled;
+    QString m_cameraId;
+    int m_fd = -1;
+
+    std::vector<int> m_positions;
+    size_t m_index = 0;
+    std::vector<double> m_scores;
+    bool m_fine = false;
+    int m_bestPosition = 0;
+    int m_settleFrames = 0;
+    double m_reference = 0.0;
+    double m_referenceMean = 0.0;
+    int m_lowFrames = 0;
+    int m_current = -1;
+};
