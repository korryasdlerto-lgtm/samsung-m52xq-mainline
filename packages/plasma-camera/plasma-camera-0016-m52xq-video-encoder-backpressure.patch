diff -ruN a/src/m52xq/rawvideo.cpp b/src/m52xq/rawvideo.cpp
--- a/src/m52xq/rawvideo.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/src/m52xq/rawvideo.cpp	2026-10-22 02:36:40.516129139 +0300
@@ -0,0 +1,651 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// m52xq: see rawvideo.h
+
+#include "rawvideo.h"
+#include "videoenc.h"
+
+#include <QDebug>
+#include <QFile>
+
+#include <epoxy/egl.h>
+#include <epoxy/gl.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+
+#ifndef DRM_FORMAT_R8
+#define DRM_FORMAT_R8 0x20203852 // fourcc 'R8  ' (drm_fourcc.h)
+#endif
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+
+namespace
+{
+const char *kVertex =
+    "#version 300 es\n"
+    "void main() {\n"
+    "    vec2 p = vec2(float((gl_VertexID & 1) * 2 - 1), float((gl_VertexID >> 1) * 2 - 1));\n"
+    "    gl_Position = vec4(p, 0.0, 1.0);\n"
+    "}\n";
+
+// shared: 8 most significant bits of the packed RAW10 pixel, bilinear demosaic at an integer position, colour
+const char *kDevelopCommon =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D raw;\n"
+    "uniform ivec2 size;\n"
+    "uniform ivec2 redPos;\n"   // position of the red pixel in the 2x2 cell
+    "uniform vec3 gains;\n"     // white balance x digital gain
+    "uniform float black;\n"
+    // r52: the camera dma-buf holds 'fold' sensor rows per texture row (its pitch has to be a multiple of 64 bytes)
+    "uniform int fold;\n"
+    "uniform int rawStride;\n"
+    "out vec4 frag;\n"
+    "float px(ivec2 p) {\n"
+    "    p = clamp(p, ivec2(0), size - 1);\n"
+    "    int col = (p.x >> 2) * 5 + (p.x & 3);\n"
+    "    return texelFetch(raw, ivec2(col + (p.y % fold) * rawStride, p.y / fold), 0).r;\n"
+    "}\n"
+    "vec3 develop(ivec2 p) {\n"
+    "    float c = px(p);\n"
+    "    float n = px(p + ivec2(0, -1)), s = px(p + ivec2(0, 1)), e = px(p + ivec2(1, 0)), w = px(p + ivec2(-1, 0));\n"
+    "    float d = (px(p + ivec2(-1, -1)) + px(p + ivec2(1, -1)) + px(p + ivec2(-1, 1)) + px(p + ivec2(1, 1))) * 0.25;\n"
+    "    int rx = (p.x - redPos.x) & 1, ry = (p.y - redPos.y) & 1;\n"
+    "    vec3 rgb;\n"
+    "    if (rx == 0 && ry == 0) rgb = vec3(c, (n + s + e + w) * 0.25, d);\n"
+    "    else if (rx == 1 && ry == 1) rgb = vec3(d, (n + s + e + w) * 0.25, c);\n"
+    "    else if (ry == 0) rgb = vec3((e + w) * 0.5, c, (n + s) * 0.5);\n"
+    "    else rgb = vec3((n + s) * 0.5, c, (e + w) * 0.5);\n"
+    "    rgb = max(rgb - vec3(black), vec3(0.0)) / (1.0 - black) * gains;\n"
+    "    vec3 g = pow(clamp(rgb, 0.0, 1.0), vec3(1.0 / 2.2));\n"
+    // r46: the look of Megapixels / the viewfinder (the video was flat and grey): S-curve k=0.5, +25 % saturation
+    "    g += 0.5 * (g * g * (3.0 - 2.0 * g) - g);\n"
+    "    float l = dot(g, vec3(0.299, 0.587, 0.114));\n"
+    "    return clamp(vec3(l) + (g - vec3(l)) * 1.25, 0.0, 1.0);\n"
+    "}\n";
+
+// pass 1: the upright video frame; source position = a0 + ax * x + ay * y (crop, zoom, rotation, mirror)
+const char *kVideoMain =
+    "uniform vec2 a0;\n"
+    "uniform vec2 ax;\n"
+    "uniform vec2 ay;\n"
+    // r57: smaller videos (FHD from the 4624 wide frame): the mean of 4 source points per output pixel (no aliasing)
+    "uniform int supersample;\n"
+    "void main() {\n"
+    "    vec2 o = gl_FragCoord.xy;\n"
+    "    vec2 s = a0 + ax * o.x + ay * o.y;\n"
+    "    if (supersample == 0) {\n"
+    "        frag = vec4(develop(ivec2(floor(s))), 1.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    vec2 qx = ax * 0.25, qy = ay * 0.25;\n"
+    "    vec3 c = develop(ivec2(floor(s - qx - qy))) + develop(ivec2(floor(s + qx - qy)))\n"
+    "           + develop(ivec2(floor(s - qx + qy))) + develop(ivec2(floor(s + qx + qy)));\n"
+    "    frag = vec4(c * 0.25, 1.0);\n"
+    "}\n";
+
+// viewfinder: a quarter of the frame in the camera orientation
+const char *kViewMain =
+    "void main() {\n"
+    "    ivec2 o = ivec2(gl_FragCoord.xy);\n"
+    "    frag = vec4(develop(o * 4 + ivec2(1, 1)), 1.0);\n"
+    "}\n";
+
+// pass 2: RGBA -> NV12 (BT.709 limited range); output row r = Y row r, then the UV rows
+const char *kPack =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D tex;\n"
+    "uniform ivec2 outSize;\n"
+    "out vec4 frag;\n"
+    "float y8(vec3 c) { return (16.0 + 219.0 * dot(c, vec3(0.2126, 0.7152, 0.0722))) / 255.0; }\n"
+    "vec2 uv8(vec3 c) { float y = dot(c, vec3(0.2126, 0.7152, 0.0722));\n"
+    "    return vec2(128.0 + 224.0 * (c.b - y) / 1.8556, 128.0 + 224.0 * (c.r - y) / 1.5748) / 255.0; }\n"
+    "void main() {\n"
+    "    ivec2 f = ivec2(gl_FragCoord.xy);\n"
+    "    if (f.y < outSize.y) {\n"
+    "        int x = f.x * 4;\n"
+    "        frag = vec4(y8(texelFetch(tex, ivec2(x, f.y), 0).rgb), y8(texelFetch(tex, ivec2(x + 1, f.y), 0).rgb),\n"
+    "                    y8(texelFetch(tex, ivec2(x + 2, f.y), 0).rgb), y8(texelFetch(tex, ivec2(x + 3, f.y), 0).rgb));\n"
+    "    } else {\n"
+    "        int r = (f.y - outSize.y) * 2;\n"
+    "        int x = f.x * 4;\n"
+    "        vec2 a = uv8(texelFetch(tex, ivec2(x, r), 0).rgb);\n"
+    "        vec2 b = uv8(texelFetch(tex, ivec2(x + 2, r), 0).rgb);\n"
+    "        frag = vec4(a.x, a.y, b.x, b.y);\n"
+    "    }\n"
+    "}\n";
+
+GLuint compile(GLenum type, const std::string &src)
+{
+    GLuint sh = glCreateShader(type);
+    const char *p = src.c_str();
+    glShaderSource(sh, 1, &p, nullptr);
+    glCompileShader(sh);
+    GLint ok = 0;
+    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char log[2048] = "";
+        glGetShaderInfoLog(sh, sizeof(log), nullptr, log);
+        qWarning() << "m52xq rawvideo: shader:" << log;
+        glDeleteShader(sh);
+        return 0;
+    }
+    return sh;
+}
+
+GLuint program(const std::string &fragment)
+{
+    GLuint vs = compile(GL_VERTEX_SHADER, kVertex), fs = compile(GL_FRAGMENT_SHADER, fragment);
+    if (!vs || !fs) {
+        return 0;
+    }
+    GLuint p = glCreateProgram();
+    glAttachShader(p, vs);
+    glAttachShader(p, fs);
+    glLinkProgram(p);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(p, GL_LINK_STATUS, &ok);
+    if (!ok) {
+        qWarning() << "m52xq rawvideo: link failed";
+        glDeleteProgram(p);
+        return 0;
+    }
+    return p;
+}
+
+GLuint makeTarget(GLenum internal, int w, int h, GLuint *fb)
+{
+    GLuint t;
+    glGenTextures(1, &t);
+    glBindTexture(GL_TEXTURE_2D, t);
+    glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glGenFramebuffers(1, fb);
+    glBindFramebuffer(GL_FRAMEBUFFER, *fb);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t, 0);
+    return t;
+}
+} // namespace
+
+M52xqRawVideo::M52xqRawVideo(QObject *parent)
+    : QObject(parent)
+{
+}
+
+M52xqRawVideo::~M52xqRawVideo()
+{
+    stop();
+}
+
+bool M52xqRawVideo::start(M52xqVideoEncoder *encoder, int outW, int outH, int rotation, bool mirror)
+{
+    stop();
+    m_encoder = encoder;
+    m_outW = outW & ~3;
+    m_outH = outH & ~1;
+    m_rotation = ((rotation % 360) + 360) % 360;
+    m_mirror = mirror;
+    m_quit = false;
+    m_hasFrame = false;
+    m_frames = 0;
+    m_dropped = 0;
+    m_dmabufOk = true; // r52: tried again for every recording (another camera, another stride)
+    m_thread = std::thread(&M52xqRawVideo::loop, this);
+    return true;
+}
+
+void M52xqRawVideo::stop()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_quit = true;
+    }
+    m_cv.notify_all();
+    if (m_thread.joinable()) {
+        m_thread.join();
+        std::function<void()> pending;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            pending = std::move(m_release);
+            m_release = nullptr;
+            m_fd = -1;
+            m_hasFrame = false;
+        }
+        if (pending) {
+            pending(); // the camera buffer of a frame that was not developed any more
+        }
+        qInfo() << "m52xq rawvideo: stopped," << m_frames.load() << "frames developed," << m_dropped.load() << "dropped";
+    }
+}
+
+void M52xqRawVideo::setParams(double digitalGain, double zoom)
+{
+    m_gain = digitalGain;
+    m_zoom = zoom;
+}
+
+void M52xqRawVideo::pushRaw(const uint8_t *data, size_t size, int width, int height, int stride, const QString &cfa)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    if (m_quit || m_hasFrame) {
+        ++m_dropped; // the GPU thread is still busy with the previous frame
+        return;
+    }
+    lock.unlock();
+    QByteArray copy(reinterpret_cast<const char *>(data), static_cast<qsizetype>(size)); // the camera reuses its buffer
+    lock.lock();
+    m_frame = std::move(copy);
+    m_w = width;
+    m_h = height;
+    m_stride = stride;
+    m_cfa = cfa;
+    m_hasFrame = true;
+    lock.unlock();
+    m_cv.notify_all();
+}
+
+bool M52xqRawVideo::pushRawDmabuf(int fd, unsigned offset, int width, int height, int stride, const QString &cfa,
+                                  std::function<void()> release)
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_quit || m_hasFrame) {
+            ++m_dropped;
+            return false;
+        }
+        m_frame = QByteArray();
+        m_fd = fd;
+        m_offset = offset;
+        m_release = std::move(release);
+        m_w = width;
+        m_h = height;
+        m_stride = stride;
+        m_cfa = cfa;
+        m_hasFrame = true;
+    }
+    m_cv.notify_all();
+    return true;
+}
+
+void M52xqRawVideo::loop()
+{
+    // --- surfaceless EGL / GLES 3 context of this thread ---
+    EGLDisplay dpy = EGL_NO_DISPLAY;
+    if (epoxy_has_egl_extension(EGL_NO_DISPLAY, "EGL_MESA_platform_surfaceless")) {
+        dpy = eglGetPlatformDisplayEXT(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, nullptr);
+    }
+    if (dpy == EGL_NO_DISPLAY || !eglInitialize(dpy, nullptr, nullptr)) {
+        qWarning() << "m52xq rawvideo: no EGL display";
+        return;
+    }
+    eglBindAPI(EGL_OPENGL_ES_API);
+    const EGLint ctxAttrs[] = {EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 0, EGL_NONE};
+    EGLContext ctx = eglCreateContext(dpy, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, ctxAttrs);
+    if (ctx == EGL_NO_CONTEXT || !eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, ctx)) {
+        qWarning() << "m52xq rawvideo: no GLES 3 context" << Qt::hex << eglGetError();
+        return;
+    }
+    const GLuint progVideo = program(std::string(kDevelopCommon) + kVideoMain);
+    const GLuint progView = program(std::string(kDevelopCommon) + kViewMain);
+    const GLuint progPack = program(kPack);
+    if (!progVideo || !progView || !progPack) {
+        eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        eglDestroyContext(dpy, ctx);
+        return;
+    }
+
+    GLuint rawTex = 0, rgbTex = 0, rgbFb = 0, packTex = 0, packFb = 0, viewTex = 0, viewFb = 0;
+    int texStride = 0, texH = 0;
+    QImage view;
+    double wbR = 1.0, wbB = 1.0; // gray world white balance, adapted slowly
+    std::vector<uint8_t> nv12Scratch;
+    double tSum = 0, tUp = 0, tView = 0, tVid = 0, tRead = 0, tVDraw = 0, tVRead = 0;
+    // r50: viewfinder images handed out in turn (no 4 MB copy per frame): an image still held by the GUI is skipped
+    QImage viewPool[3];
+    int tN = 0;
+    // r47: the GPU frequency floor at its maximum while recording (the governor stayed low: 44 ms per frame)
+    auto readMinFreq = []() {
+        QFile f(QStringLiteral("/sys/class/devfreq/3d00000.qcom,kgsl-3d0/min_freq"));
+        return f.open(QIODevice::ReadOnly) ? f.readAll().trimmed() : QByteArray();
+    };
+    auto writeMinFreq = [](const QByteArray &v) {
+        QFile f(QStringLiteral("/sys/class/devfreq/3d00000.qcom,kgsl-3d0/min_freq"));
+        if (!v.isEmpty() && f.open(QIODevice::WriteOnly)) {
+            f.write(v);
+        }
+    };
+    // r50: back to the lowest frequency afterwards (the saved value could be a floor another run had left behind:
+    // 630 / 812 MHz stayed set after r48 / r49)
+    QByteArray lowestFreq = QByteArrayLiteral("315000000");
+    {
+        QFile af(QStringLiteral("/sys/class/devfreq/3d00000.qcom,kgsl-3d0/available_frequencies"));
+        if (af.open(QIODevice::ReadOnly)) {
+            const QList<QByteArray> l = af.readAll().simplified().split(' ');
+            if (!l.isEmpty() && !l.first().isEmpty()) {
+                lowestFreq = l.first();
+            }
+        }
+    }
+    const QByteArray savedMinFreq = readMinFreq();
+    {
+        QFile mf(QStringLiteral("/sys/class/devfreq/3d00000.qcom,kgsl-3d0/max_freq"));
+        if (mf.open(QIODevice::ReadOnly)) {
+            writeMinFreq(mf.readAll().trimmed());
+        }
+        qInfo() << "m52xq rawvideo: GPU min_freq" << savedMinFreq << "->" << readMinFreq();
+    }
+    // r49: white balance + viewfinder signal from the read-back viewfinder frame
+    auto useView = [&]() {
+        // gray world on the viewfinder frame (it already carries the present gains)
+        {
+            double sr = 0, sg = 0, sb = 0;
+            for (int y = 0; y < view.height(); y += 4) {
+                const uchar *l = view.constScanLine(y);
+                for (int x = 0; x < view.width(); x += 4) {
+                    const uchar *p = l + x * 4;
+                    if (p[0] > 245 || p[1] > 245 || p[2] > 245) {
+                        continue;
+                    }
+                    sr += p[0];
+                    sg += p[1];
+                    sb += p[2];
+                }
+            }
+            if (sr > 1000 && sb > 1000 && sg > 1000) {
+                // the values are gamma coded: the linear ratio is ratio^2.2
+                const double cr = std::pow(sg / sr, 2.2), cb = std::pow(sg / sb, 2.2);
+                wbR = std::clamp(wbR * std::pow(cr, 0.15), 0.4, 4.0);
+                wbB = std::clamp(wbB * std::pow(cb, 0.15), 0.4, 4.0);
+            }
+        }
+        Q_EMIT viewfinderFrame(view);
+    };
+
+    // r51: one texture per camera dma-buf (EGLImage, R8, linear, pitch = stride): the GPU reads the camera buffer itself;
+    // the copy (pushRaw memcpy 20 MB + glTexSubImage2D + the work of the GPU on the upload) took 18-21 ms per frame
+    struct DmabufTex {
+        EGLImageKHR image = EGL_NO_IMAGE_KHR;
+        GLuint tex = 0;
+    };
+    std::map<std::pair<int, unsigned>, DmabufTex> dmabufTex;
+    // r52: freedreno imports only pitches that are multiples of 64 bytes (stride main 5792, front 4080 / 8160 are not):
+    // 'fold' sensor rows side by side in one texture row (pitch fold x stride, at most the maximum texture width)
+    GLint maxTex = 0;
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maxTex);
+    auto foldFor = [&](int stride, int h) {
+        for (int k = 1; k <= 8; k *= 2) {
+            if ((k * stride) % 64 == 0 && k * stride <= maxTex && h % k == 0) {
+                return k;
+            }
+        }
+        return 0;
+    };
+    // r53: the main camera (fold 2: 1734 rows) still failed with EGL_BAD_ALLOC, the front (fold 4: 612 rows) worked: the
+    // image height is tried as it is, then rounded down to 4 and 32 rows (the last sensor rows are outside the 16:9 crop)
+    int rawRows = 0; // sensor rows the imported texture holds
+    auto importDmabuf = [&](int fd, unsigned offset, int stride, int h, int k) -> GLuint {
+        auto it = dmabufTex.find({fd, offset});
+        if (it != dmabufTex.end()) {
+            return it->second.tex;
+        }
+        EGLImageKHR img = EGL_NO_IMAGE_KHR;
+        EGLint err = EGL_SUCCESS;
+        for (const int align : {1, 4, 32}) {
+            const int rows = (h / k) / align * align;
+            const EGLint attrs[] = {EGL_WIDTH, k * stride, EGL_HEIGHT, rows, EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_R8,
+                                    EGL_DMA_BUF_PLANE0_FD_EXT, fd, EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLint>(offset),
+                                    EGL_DMA_BUF_PLANE0_PITCH_EXT, k * stride, EGL_NONE};
+            img = eglCreateImageKHR(dpy, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+            if (img != EGL_NO_IMAGE_KHR) {
+                if (rawRows == 0 || rows * k < rawRows) {
+                    rawRows = rows * k;
+                }
+                break;
+            }
+            err = eglGetError();
+            qInfo() << "m52xq rawvideo: dma-buf import with" << rows << "rows:" << Qt::hex << err << Qt::dec;
+        }
+        if (img == EGL_NO_IMAGE_KHR) {
+            qWarning() << "m52xq rawvideo: dma-buf import failed" << Qt::hex << err << Qt::dec << "stride" << stride
+                       << "fold" << k << "- copying the frames";
+            return 0;
+        }
+        DmabufTex d;
+        d.image = img;
+        glGenTextures(1, &d.tex);
+        glBindTexture(GL_TEXTURE_2D, d.tex);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, img);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        if (glGetError() != GL_NO_ERROR) {
+            qWarning() << "m52xq rawvideo: dma-buf texture failed - copying the frames";
+            glDeleteTextures(1, &d.tex);
+            eglDestroyImageKHR(dpy, img);
+            return 0;
+        }
+        qInfo() << "m52xq rawvideo: camera dma-buf" << fd << "imported, stride" << stride << "x" << h << "fold" << k << "rows"
+                << rawRows;
+        dmabufTex[{fd, offset}] = d;
+        return d.tex;
+    };
+
+    for (;;) {
+        QByteArray raw;
+        int w, h, stride;
+        QString cfa;
+        int fd = -1;
+        unsigned offset = 0;
+        std::function<void()> release;
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_cv.wait(lock, [this]() { return m_quit || m_hasFrame; });
+            if (m_quit) {
+                break;
+            }
+            raw = std::move(m_frame);
+            m_frame = QByteArray();
+            fd = m_fd;
+            offset = m_offset;
+            release = std::move(m_release);
+            m_fd = -1;
+            m_release = nullptr;
+            w = m_w;
+            h = m_h;
+            stride = m_stride;
+            cfa = m_cfa;
+            m_hasFrame = false; // r47: the camera thread may already copy the next frame while this one is developed
+        }
+        const auto t0 = std::chrono::steady_clock::now();
+
+        if (!rawTex || texStride != stride || texH != h) {
+            if (rawTex) {
+                glDeleteTextures(1, &rawTex);
+            }
+            glGenTextures(1, &rawTex);
+            glBindTexture(GL_TEXTURE_2D, rawTex);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, stride, h, 0, GL_RED, GL_UNSIGNED_BYTE, nullptr);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            texStride = stride;
+            texH = h;
+            rgbTex = makeTarget(GL_RGBA8, m_outW, m_outH, &rgbFb);
+            packTex = makeTarget(GL_RGBA8, m_outW / 4, m_outH * 3 / 2, &packFb);
+            viewTex = makeTarget(GL_RGBA8, w / 4, h / 4, &viewFb);
+            for (auto &img : viewPool) {
+                img = QImage(w / 4, h / 4, QImage::Format_RGBX8888);
+            }
+        }
+        glActiveTexture(GL_TEXTURE0);
+        int fold = 1;
+        if (fd >= 0) {
+            fold = foldFor(stride, h);
+            const GLuint t = fold ? importDmabuf(fd, offset, stride, h, fold) : 0;
+            if (!t) {
+                m_dmabufOk = false; // the next frames come as copies
+                if (release) {
+                    release();
+                }
+                continue;
+            }
+            glBindTexture(GL_TEXTURE_2D, t);
+        } else {
+            glBindTexture(GL_TEXTURE_2D, rawTex);
+            glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+            glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, stride, h, GL_RED, GL_UNSIGNED_BYTE, raw.constData());
+            raw = QByteArray(); // the raw copy is not needed any more
+            glFinish(); // r50: measure the upload with the work of the GPU on it
+        }
+        const auto tA = std::chrono::steady_clock::now();
+
+        // red position of the 2x2 cell from the pattern name
+        const QString c = cfa.left(4);
+        const int ri = std::max(0, static_cast<int>(c.indexOf(QLatin1Char('R'))));
+        const int redX = ri & 1, redY = ri >> 1;
+
+        // viewfinder (white balance only: the screen and the auto exposure apply the digital gain themselves)
+        auto setCommon = [&](GLuint p, double gain) {
+            glUseProgram(p);
+            glUniform1i(glGetUniformLocation(p, "raw"), 0);
+            glUniform2i(glGetUniformLocation(p, "size"), w, fd >= 0 && rawRows > 0 ? std::min(h, rawRows) : h);
+            glUniform2i(glGetUniformLocation(p, "redPos"), redX, redY);
+            glUniform3f(glGetUniformLocation(p, "gains"), float(wbR * gain), float(gain), float(wbB * gain));
+            glUniform1f(glGetUniformLocation(p, "black"), 16.0f / 255.0f);
+            glUniform1i(glGetUniformLocation(p, "fold"), fold);
+            glUniform1i(glGetUniformLocation(p, "rawStride"), stride);
+        };
+        // the viewfinder (and the white balance) on every frame: skipping frames made it judder.
+        glBindFramebuffer(GL_FRAMEBUFFER, viewFb);
+        glViewport(0, 0, w / 4, h / 4);
+        setCommon(progView, 1.0);
+        glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+        glFinish();
+        const auto tV1 = std::chrono::steady_clock::now();
+        // (swapped out of the pool, so that bits() does not detach it)
+        int slot = -1;
+        for (int i = 0; i < 3; ++i) {
+            if (!viewPool[i].isNull() && viewPool[i].isDetached()) {
+                slot = i;
+                view.swap(viewPool[i]);
+                break;
+            }
+        }
+        if (slot < 0) { // all three still on the screen: one more
+            view = QImage(w / 4, h / 4, QImage::Format_RGBX8888);
+        }
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        // r49: synchronous read-back straight into the image like Megapixels (with GALLIUM_THREAD=0 in m52xq-camera-launch:
+        // the mapped pixel buffers of r47/r48 were slow memory, 21-72 ms per frame)
+        glReadPixels(0, 0, w / 4, h / 4, GL_RGBA, GL_UNSIGNED_BYTE, view.bits());
+        const auto tV2 = std::chrono::steady_clock::now();
+        tVDraw += std::chrono::duration<double, std::milli>(tV1 - tA).count();
+        tVRead += std::chrono::duration<double, std::milli>(tV2 - tV1).count();
+        useView();
+        if (slot >= 0) {
+            viewPool[slot].swap(view); // back into the pool, shared with the GUI until it drops the frame
+        }
+        view = QImage();
+        const auto tB = std::chrono::steady_clock::now();
+
+        // the video frame
+        {
+            // output (x, y) (gl_FragCoord, row 0 = top of the upright video) -> source position, as in videoenc convert()
+            const int rot = m_rotation;
+            const bool swap = rot == 90 || rot == 270;
+            const double Wd = swap ? h : w, Hd = swap ? w : h;
+            const double z = std::max(1.0, m_zoom.load());
+            const double s = std::max(m_outW / (Wd / z), m_outH / (Hd / z));
+            auto map = [&](double ox, double oy, double *xs, double *ys) {
+                const double xd = Wd / 2 + (ox - m_outW / 2.0) / s;
+                const double yd = Hd / 2 + (oy - m_outH / 2.0) / s;
+                double xm, ym;
+                switch (rot) {
+                case 90:
+                    xm = yd;
+                    ym = h - xd;
+                    break;
+                case 180:
+                    xm = w - xd;
+                    ym = h - yd;
+                    break;
+                case 270:
+                    xm = w - yd;
+                    ym = xd;
+                    break;
+                default:
+                    xm = xd;
+                    ym = yd;
+                    break;
+                }
+                *xs = xm;
+                *ys = m_mirror ? h - ym : ym;
+            };
+            double x0, y0, x1, y1, x2, y2;
+            map(0, 0, &x0, &y0);
+            map(1, 0, &x1, &y1);
+            map(0, 1, &x2, &y2);
+
+            glBindFramebuffer(GL_FRAMEBUFFER, rgbFb);
+            glViewport(0, 0, m_outW, m_outH);
+            setCommon(progVideo, m_gain.load());
+            glUniform2f(glGetUniformLocation(progVideo, "a0"), float(x0), float(y0));
+            glUniform2f(glGetUniformLocation(progVideo, "ax"), float(x1 - x0), float(y1 - y0));
+            glUniform2f(glGetUniformLocation(progVideo, "ay"), float(x2 - x0), float(y2 - y0));
+            glUniform1i(glGetUniformLocation(progVideo, "supersample"), std::hypot(x1 - x0, y1 - y0) > 1.5 ? 1 : 0);
+            glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+
+            glBindFramebuffer(GL_FRAMEBUFFER, packFb);
+            glViewport(0, 0, m_outW / 4, m_outH * 3 / 2);
+            glUseProgram(progPack);
+            glBindTexture(GL_TEXTURE_2D, rgbTex);
+            glUniform1i(glGetUniformLocation(progPack, "tex"), 0);
+            glUniform2i(glGetUniformLocation(progPack, "outSize"), m_outW, m_outH);
+            glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+            // r49: the Megapixels way: finish, then one synchronous glReadPixels straight into a buffer of the encoder
+            glFinish();
+            if (release) {
+                release(); // r51: the GPU is done with the camera buffer: back to the camera
+                release = nullptr;
+            }
+            const auto tC = std::chrono::steady_clock::now();
+            uint8_t *dst = nullptr;
+            const int idx = m_encoder ? m_encoder->acquireBuffer(&dst) : -1;
+            if (idx >= 0) {
+                glReadPixels(0, 0, m_outW / 4, m_outH * 3 / 2, GL_RGBA, GL_UNSIGNED_BYTE, dst);
+                m_encoder->commitBuffer(idx);
+            }
+            tVid += std::chrono::duration<double, std::milli>(tC - tB).count();
+            tRead += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - tC).count();
+        }
+        ++m_frames;
+        const auto tEnd = std::chrono::steady_clock::now();
+        tSum += std::chrono::duration<double, std::milli>(tEnd - t0).count();
+        tUp += std::chrono::duration<double, std::milli>(tA - t0).count();
+        tView += std::chrono::duration<double, std::milli>(tB - tA).count();
+        if (++tN == 60) {
+            qInfo() << "m52xq rawvideo: per frame" << tSum / tN << "ms (upload" << tUp / tN << "view" << tView / tN << "= draw" << tVDraw / tN << "read" << tVRead / tN << "+ wb/emit"
+                    << (tView - tVDraw - tVRead) / tN << "video"
+                    << tVid / tN << "read-back" << tRead / tN << "), wb" << wbR << wbB << "gain" << m_gain.load();
+            tSum = tUp = tView = tVid = tRead = tVDraw = tVRead = 0;
+            tN = 0;
+        }
+    }
+    for (auto &[key, d] : dmabufTex) {
+        glDeleteTextures(1, &d.tex);
+        eglDestroyImageKHR(dpy, d.image);
+    }
+    dmabufTex.clear();
+    writeMinFreq(lowestFreq);
+    qInfo() << "m52xq rawvideo: GPU min_freq back to" << readMinFreq();
+
+    eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    eglDestroyContext(dpy, ctx);
+}
diff -ruN a/src/m52xq/rawvideo.h b/src/m52xq/rawvideo.h
--- a/src/m52xq/rawvideo.h	1970-01-01 02:00:00.000000000 +0200
+++ b/src/m52xq/rawvideo.h	2026-10-21 23:54:36.746234370 +0300
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// m52xq: real 4K video in plasma-camera like the m52xq Megapixels build: while recording the camera delivers its raw
+// RAW10 stream (main 4624x3468, front 3264x2448, ~20 fps) and this class develops every frame on the GPU (own surfaceless
+// EGL context in its own thread): bilinear demosaic, white balance, digital gain, gamma, crop/rotation/mirror into the
+// upright 3840x2160 frame, NV12 packing (to M52xqVideoEncoder = Venus) and a quarter-size viewfinder frame for the screen
+// and the auto exposure. libcamera's software ISP managed only ~8 fps at 16 MP.
+
+#pragma once
+
+#include <QByteArray>
+#include <QImage>
+#include <QObject>
+#include <QString>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <thread>
+
+class M52xqVideoEncoder;
+class M52xqRawVideo;
+
+// fed by the camera worker thread with every raw frame
+inline std::atomic<M52xqRawVideo *> g_m52xqRawVideo{nullptr};
+
+class M52xqRawVideo : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit M52xqRawVideo(QObject *parent = nullptr);
+    ~M52xqRawVideo() override;
+
+    // outW x outH = upright video size; rotation/mirror like the still photo; cfa e.g. "GRBG"
+    bool start(M52xqVideoEncoder *encoder, int outW, int outH, int rotation, bool mirror);
+    void stop();
+    // camera worker thread: the raw frame (copied when the GPU thread is free, else dropped)
+    void pushRaw(const uint8_t *data, size_t size, int width, int height, int stride, const QString &cfa);
+    // r51: camera worker thread: the frame as the dma-buf of the camera buffer (no copy). release() is called (from the GPU
+    // thread) when the GPU no longer reads the buffer. false: not taken (busy or stopped), the caller keeps the buffer.
+    bool pushRawDmabuf(int fd, unsigned offset, int width, int height, int stride, const QString &cfa,
+                       std::function<void()> release);
+    // false after the import of a dma-buf failed once: pushRaw() (copy) is used then
+    bool dmabufUsable() const { return m_dmabufOk.load(); }
+    // GUI thread: digital gain of the auto exposure and the digital zoom
+    void setParams(double digitalGain, double zoom);
+
+Q_SIGNALS:
+    // quarter-size frame in the camera orientation (white balance applied, no digital gain) for the viewfinder
+    void viewfinderFrame(const QImage &frame);
+
+private:
+    void loop();
+
+    M52xqVideoEncoder *m_encoder = nullptr;
+    int m_outW = 0, m_outH = 0, m_rotation = 0;
+    bool m_mirror = false;
+
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    QByteArray m_frame; // the next raw frame
+    int m_w = 0, m_h = 0, m_stride = 0;
+    QString m_cfa;
+    bool m_hasFrame = false;
+    int m_fd = -1; // r51: dma-buf frame instead of m_frame
+    unsigned m_offset = 0;
+    std::function<void()> m_release;
+    std::atomic<bool> m_dmabufOk{true};
+    bool m_quit = false;
+    std::thread m_thread;
+    std::atomic<double> m_gain{1.0};
+    std::atomic<double> m_zoom{1.0};
+    std::atomic<int> m_frames{0}, m_dropped{0};
+};
diff -ruN a/src/m52xq/videoenc.cpp b/src/m52xq/videoenc.cpp
--- a/src/m52xq/videoenc.cpp	1970-01-01 02:00:00.000000000 +0200
+++ b/src/m52xq/videoenc.cpp	2026-10-22 02:44:04.918815954 +0300
@@ -0,0 +1,449 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// m52xq: see videoenc.h. The encoder commands are those of the m52xq Megapixels build (r48/r52/r77).
+
+#include "videoenc.h"
+
+#include <QDebug>
+#include <QFile>
+#include <QMetaObject>
+
+#include <algorithm>
+#include <cmath>
+#include <csignal>
+#include <fcntl.h>
+#include <spawn.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+static constexpr int kBuffers = 3;
+
+static QString shellQuote(const QString &s)
+{
+    QString q = s;
+    q.replace(QLatin1String("'"), QLatin1String("'\\''"));
+    return QLatin1Char('\'') + q + QLatin1Char('\'');
+}
+
+M52xqVideoEncoder::M52xqVideoEncoder(QObject *parent)
+    : QObject(parent)
+{
+}
+
+M52xqVideoEncoder::~M52xqVideoEncoder()
+{
+    if (m_pid > 0) {
+        stop();
+    }
+    if (m_writer.joinable()) {
+        m_writer.join();
+    }
+    if (m_waiter.joinable()) {
+        m_waiter.join();
+    }
+}
+
+bool M52xqVideoEncoder::start(const QString &fileName, int width, int height, bool hardware, bool audio)
+{
+    if (m_pid > 0 || width <= 0 || height <= 0) {
+        return false;
+    }
+    if (m_writer.joinable()) {
+        m_writer.join();
+    }
+    if (m_waiter.joinable()) {
+        m_waiter.join();
+    }
+    m_fileName = fileName;
+    m_width = width & ~1;
+    m_height = height & ~1;
+    m_hardware = hardware;
+    m_frameSize = static_cast<size_t>(m_width) * m_height * 3 / 2;
+    m_dropped = 0;
+    m_written = 0;
+
+    const QString out = shellQuote(fileName);
+    QString cmd;
+    if (hardware) {
+        // GStreamer does the whole recording (one clock for the video from stdin and the microphone); on stop the shell
+        // forwards SIGINT to gst-launch (-e: EOS, finished file); then ffmpeg only copies the streams and sets the BT.709 tags
+        const QString raw = shellQuote(fileName + QLatin1String(".raw.mkv"));
+        const QString audioPart = audio
+            ? QStringLiteral("pulsesrc ! audio/x-raw,channels=1 ! audioconvert ! volume volume=6 ! audioresample ! vorbisenc bitrate=96000 ! queue ! mux.audio_0 ")
+            : QString();
+        cmd = QStringLiteral("exec 3<&0; gst-launch-1.0 -e -q matroskamux name=mux ! filesink location=%1 "
+                             "filesrc location=/dev/stdin blocksize=%2 do-timestamp=true ! "
+                             "video/x-raw,format=NV12,width=%3,height=%4,framerate=30/1 ! queue max-size-buffers=4 ! "
+                             "v4l2h264enc extra-controls=\"controls,video_bitrate_mode=1,video_bitrate=40000000;\" ! "
+                             "h264parse ! queue ! mux.video_0 %5<&3 & "
+                             "P=$!; trap 'kill -INT $P' INT; wait $P; wait $P; "
+                             "ffmpeg -y -loglevel warning -i %1 -c copy "
+                             "-bsf:v h264_metadata=colour_primaries=1:transfer_characteristics=1:matrix_coefficients=1:video_full_range_flag=0:level=5.1 %6; "
+                             "rm -f %1")
+                  .arg(raw)
+                  .arg(m_frameSize)
+                  .arg(m_width)
+                  .arg(m_height)
+                  .arg(audioPart, out);
+    } else {
+        const QString audioIn = audio ? QStringLiteral("-f pulse -i default ") : QString();
+        const QString audioOut = audio ? QStringLiteral("-af volume=18dB,alimiter=limit=0.95 -c:a libvorbis -b:a 96k ") : QStringLiteral("-an ");
+        cmd = QStringLiteral("exec ffmpeg -y -loglevel warning -use_wallclock_as_timestamps 1 -f rawvideo -pixel_format nv12 "
+                             "-video_size %1x%2 -i pipe:0 %3"
+                             "-c:v libx264 -preset ultrafast -crf 27 -maxrate 17M -bufsize 34M -colorspace bt709 -color_primaries bt709 -color_trc bt709 "
+                             "-color_range tv -fps_mode vfr %4%5")
+                  .arg(m_width)
+                  .arg(m_height)
+                  .arg(audioIn, audioOut, out);
+    }
+
+    std::signal(SIGPIPE, SIG_IGN); // a finished encoder must not end plasma-camera
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) < 0) {
+        return false;
+    }
+    fcntl(fds[1], F_SETPIPE_SZ, 1 << 20);
+    posix_spawn_file_actions_t fa;
+    posix_spawn_file_actions_init(&fa);
+    posix_spawn_file_actions_adddup2(&fa, fds[0], 0);
+    const QByteArray cmdBytes = cmd.toLocal8Bit();
+    char *argv[] = {const_cast<char *>("sh"), const_cast<char *>("-c"), const_cast<char *>(cmdBytes.constData()), nullptr};
+    pid_t pid = -1;
+    const int rc = posix_spawn(&pid, "/bin/sh", &fa, nullptr, argv, environ);
+    posix_spawn_file_actions_destroy(&fa);
+    ::close(fds[0]);
+    if (rc != 0) {
+        ::close(fds[1]);
+        qWarning() << "m52xq video: cannot start the encoder" << rc;
+        return false;
+    }
+    m_pid = pid;
+    m_fd = fds[1];
+    qInfo() << "m52xq video:" << m_width << "x" << m_height << (hardware ? "Venus" : "x264") << "->" << fileName << cmd;
+
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_pool.assign(kBuffers, std::vector<uint8_t>(m_frameSize));
+        m_pending.assign(kBuffers, Pending());
+        m_free.clear();
+        m_work.clear();
+        for (int i = 0; i < kBuffers; ++i) {
+            m_free.push_back(i);
+        }
+        m_stopping = false;
+    }
+    m_writer = std::thread(&M52xqVideoEncoder::writerLoop, this);
+    m_waiter = std::thread(&M52xqVideoEncoder::waitLoop, this);
+    return true;
+}
+
+void M52xqVideoEncoder::writerLoop()
+{
+    for (;;) {
+        int idx;
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_cv.wait(lock, [this]() { return !m_work.empty() || m_stopping; });
+            if (m_work.empty()) {
+                // stopping and everything written: close the pipe (EOF), otherwise filesrc of gst-launch stays blocked in
+                // read() and the EOS of SIGINT never arrives (third 4K video of 19.10 stuck for minutes)
+                if (m_fd >= 0) {
+                    ::close(m_fd);
+                    m_fd = -1;
+                }
+                return;
+            }
+            idx = m_work.front();
+            m_work.pop_front();
+        }
+        Pending job;
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            job = std::move(m_pending[idx]);
+            m_pending[idx] = Pending();
+        }
+        if (!job.image.isNull()) { // r45: buffers from acquireBuffer are already NV12
+            convert(job.image, job.rotation, job.mirror, job.zoom, m_pool[idx].data(), job.gain, job.wb0, job.wb2);
+        }
+        job.image = QImage();
+        const uint8_t *p = m_pool[idx].data();
+        size_t left = m_frameSize;
+        bool ok = true;
+        while (left > 0) {
+            const ssize_t n = ::write(m_fd, p, left);
+            if (n <= 0) {
+                if (n < 0 && errno == EINTR) {
+                    continue;
+                }
+                ok = false;
+                break;
+            }
+            p += n;
+            left -= static_cast<size_t>(n);
+        }
+        if (ok) {
+            ++m_written;
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_free.push_back(idx);
+        }
+        if (!ok) {
+            qWarning() << "m52xq video: the encoder does not take frames any more";
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (m_fd >= 0) {
+                ::close(m_fd);
+                m_fd = -1;
+            }
+            return;
+        }
+    }
+}
+
+void M52xqVideoEncoder::waitLoop()
+{
+    int status = 0;
+    const pid_t pid = m_pid;
+    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {
+    }
+    const bool ok = QFile::exists(m_fileName) && QFile(m_fileName).size() > 0;
+    QMetaObject::invokeMethod(this, [this, ok]() {
+        if (m_writer.joinable()) {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_stopping = true;
+            }
+            m_cv.notify_all();
+            m_writer.join();
+        }
+        if (m_fd >= 0) {
+            ::close(m_fd);
+            m_fd = -1;
+        }
+        m_pid = -1;
+        qInfo() << "m52xq video: encoder finished" << (ok ? "OK" : "without a file") << m_fileName << "frames" << m_written.load()
+                << "dropped" << m_dropped.load();
+        Q_EMIT finished(ok, m_fileName);
+    }, Qt::QueuedConnection);
+}
+
+void M52xqVideoEncoder::stop()
+{
+    if (m_pid <= 0) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stopping = true;
+    }
+    m_cv.notify_all();
+    // gst-launch -e: EOS, ffmpeg: finishes the file. The writer is not waited for here (a stuck encoder must not block
+    // the GUI): when the process has ended its writes fail (EPIPE) and waitLoop joins it and closes the pipe.
+    ::kill(m_pid, SIGINT);
+}
+
+void M52xqVideoEncoder::setParams(int rotation, bool mirror, double zoom, double gain, double wb0, double wb2)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_pRotation = rotation;
+    m_pMirror = mirror;
+    m_pZoom = zoom;
+    m_pGain = gain;
+    m_pWb0 = wb0;
+    m_pWb2 = wb2;
+}
+
+int M52xqVideoEncoder::acquireBuffer(uint8_t **data)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_pid <= 0 || m_stopping || m_free.empty()) {
+        if (m_pid > 0 && !m_stopping) {
+            ++m_dropped;
+        }
+        return -1;
+    }
+    const int idx = m_free.front();
+    m_free.pop_front();
+    m_pending[idx] = Pending();
+    *data = m_pool[idx].data();
+    return idx;
+}
+
+void M52xqVideoEncoder::commitBuffer(int idx)
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_work.push_back(idx);
+    }
+    m_cv.notify_all();
+}
+
+bool M52xqVideoEncoder::wantsFrame()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_pid <= 0 || m_stopping) {
+        return false;
+    }
+    if (m_free.empty()) {
+        ++m_dropped;
+        return false;
+    }
+    return true;
+}
+
+void M52xqVideoEncoder::pushFrame(const QImage &frame)
+{
+    int idx;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_pid <= 0 || m_stopping || m_free.empty() || frame.isNull()) {
+            return;
+        }
+        idx = m_free.front();
+        m_free.pop_front();
+        m_pending[idx].image = frame;
+        m_pending[idx].rotation = m_pRotation;
+        m_pending[idx].mirror = m_pMirror;
+        m_pending[idx].zoom = m_pZoom;
+        m_pending[idx].gain = m_pGain;
+        m_pending[idx].wb0 = m_pWb0;
+        m_pending[idx].wb2 = m_pWb2;
+        m_work.push_back(idx);
+    }
+    m_cv.notify_all();
+}
+
+void M52xqVideoEncoder::pushFrame(const QImage &frame, int rotation, bool mirror, double zoom)
+{
+    if (m_pid <= 0 || frame.isNull()) {
+        return;
+    }
+    int idx;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_stopping || m_free.empty()) {
+            ++m_dropped; // the encoder is behind: drop this frame (no queue that grows)
+            return;
+        }
+        idx = m_free.front();
+        m_free.pop_front();
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_pending[idx].image = frame; // shared, the writer thread converts it
+        m_pending[idx].rotation = rotation;
+        m_pending[idx].mirror = mirror;
+        m_pending[idx].zoom = zoom;
+        m_work.push_back(idx);
+    }
+    m_cv.notify_all();
+}
+
+// one pass: (crop to the zoom and the video aspect, scale, rotate, mirror) the frame into NV12, BT.709 limited range
+void M52xqVideoEncoder::convert(const QImage &frameIn, int rotation, bool mirror, double zoom, uint8_t *out, double gain,
+                                double wb0, double wb2) const
+{
+    // digital gain of the viewfinder (gain^(1/2.2) on the gamma coded values) and its white balance, as applyDigitalGain
+    uint8_t lut[3][256];
+    {
+        const double k = std::pow(std::max(gain, 1.0), 1.0 / 2.2);
+        for (int i = 0; i < 256; ++i) {
+            lut[0][i] = static_cast<uint8_t>(std::min(255.0, i * k * wb0 + 0.5));
+            lut[1][i] = static_cast<uint8_t>(std::min(255.0, i * k + 0.5));
+            lut[2][i] = static_cast<uint8_t>(std::min(255.0, i * k * wb2 + 0.5));
+        }
+    }
+    QImage frame = frameIn;
+    int ro = 0, go = 1, bo = 2;
+    switch (frame.format()) {
+    case QImage::Format_RGBX8888:
+    case QImage::Format_RGBA8888:
+    case QImage::Format_RGBA8888_Premultiplied:
+        break;
+    case QImage::Format_RGB32:
+    case QImage::Format_ARGB32:
+    case QImage::Format_ARGB32_Premultiplied:
+        ro = 2;
+        bo = 0;
+        break;
+    default:
+        frame = frame.convertToFormat(QImage::Format_RGBX8888);
+        break;
+    }
+    const int W = frame.width(), H = frame.height();
+    const int OW = m_width, OH = m_height;
+    const int rot = ((rotation % 360) + 360) % 360;
+    const bool swap = rot == 90 || rot == 270;
+    const double Wd = swap ? H : W, Hd = swap ? W : H; // the frame as the still photo shows it
+    const double z = std::max(1.0, zoom);
+    const double s = std::max(OW / (Wd / z), OH / (Hd / z)); // output pixels per shown pixel
+
+    // output (ox, oy) -> source (xs, ys); affine, so evaluated at three points
+    auto map = [&](double ox, double oy, double *xs, double *ys) {
+        const double xd = Wd / 2 + (ox + 0.5 - OW / 2.0) / s;
+        const double yd = Hd / 2 + (oy + 0.5 - OH / 2.0) / s;
+        double xm, ym;
+        switch (rot) {
+        case 90:
+            xm = yd;
+            ym = H - xd;
+            break;
+        case 180:
+            xm = W - xd;
+            ym = H - yd;
+            break;
+        case 270:
+            xm = W - yd;
+            ym = xd;
+            break;
+        default:
+            xm = xd;
+            ym = yd;
+            break;
+        }
+        *xs = xm;
+        *ys = mirror ? H - ym : ym;
+    };
+    double x0, y0, x1, y1, x2, y2;
+    map(0, 0, &x0, &y0);
+    map(1, 0, &x1, &y1);
+    map(0, 1, &x2, &y2);
+    const double dxx = x1 - x0, dyx = y1 - y0, dxy = x2 - x0, dyy = y2 - y0;
+
+    const uchar *src = frame.constBits();
+    const qsizetype bpl = frame.bytesPerLine();
+    uint8_t *yPlane = out;
+    uint8_t *uvPlane = out + static_cast<size_t>(OW) * OH;
+
+    auto rows = [&](int from, int to) {
+        for (int oy = from; oy < to; ++oy) {
+            double xs = x0 + dxy * oy, ys = y0 + dyy * oy;
+            uint8_t *yl = yPlane + static_cast<size_t>(oy) * OW;
+            uint8_t *uvl = (oy & 1) ? nullptr : uvPlane + static_cast<size_t>(oy / 2) * OW;
+            for (int ox = 0; ox < OW; ++ox, xs += dxx, ys += dyx) {
+                const int xi = std::clamp(static_cast<int>(xs), 0, W - 1);
+                const int yi = std::clamp(static_cast<int>(ys), 0, H - 1);
+                const uchar *p = src + yi * bpl + xi * 4;
+                // lut index 0/2 = byte 0/2 of the frame, like applyDigitalGain
+                const int r = lut[ro][p[ro]], g = lut[1][p[go]], b = lut[bo][p[bo]];
+                yl[ox] = static_cast<uint8_t>(16 + ((47 * r + 157 * g + 16 * b + 128) >> 8));
+                if (uvl && !(ox & 1)) {
+                    uvl[ox] = static_cast<uint8_t>(128 + ((-26 * r - 87 * g + 112 * b + 128) >> 8));
+                    uvl[ox + 1] = static_cast<uint8_t>(128 + ((112 * r - 102 * g - 10 * b + 128) >> 8));
+                }
+            }
+        }
+    };
+    constexpr int kThreads = 6;
+    std::thread workers[kThreads - 1];
+    const int step = ((OH / kThreads) + 1) & ~1;
+    for (int t = 0; t < kThreads - 1; ++t) {
+        const int from = std::min(OH, t * step), to = std::min(OH, (t + 1) * step);
+        workers[t] = std::thread(rows, from, to);
+    }
+    rows(std::min(OH, (kThreads - 1) * step), OH);
+    for (auto &w : workers) {
+        w.join();
+    }
+}
