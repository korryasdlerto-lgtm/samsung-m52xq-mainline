+#include <QObject>
+#include <QString>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class M52xqVideoEncoder;
+// r44: the recording encoder, fed directly by the camera worker thread with every camera frame (the GUI thread got only
+// ~2 frames per second of the 16 MP viewfinder: 21 frames in 12 s)
+inline std::atomic<M52xqVideoEncoder *> g_m52xqVideoEncoder{nullptr};
+
+class M52xqVideoEncoder : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit M52xqVideoEncoder(QObject *parent = nullptr);
+    ~M52xqVideoEncoder() override;
+
+    // width x height = the upright size of the video; hardware: Venus (4K); audio: record the microphone
+    bool start(const QString &fileName, int width, int height, bool hardware, bool audio);
+    // the viewfinder frame (camera orientation); rotation clockwise in degrees and the vertical mirror like the still photo,
+    // zoom: the middle 1/zoom of the frame. Drops the frame when all buffers are busy.
+    void pushFrame(const QImage &frame, int rotation, bool mirror, double zoom);
+    // r44: frame from the camera worker with the parameters set by setParams (rotation, mirror, zoom, digital gain and
+    // white balance of the viewfinder, applied while converting)
+    void pushFrame(const QImage &frame);
+    void setParams(int rotation, bool mirror, double zoom, double gain, double wb0, double wb2);
+    bool wantsFrame();
+    // r45: a ready NV12 frame (the GPU raw path): get a free buffer of width*height*3/2 bytes, fill it, commit it
+    int acquireBuffer(uint8_t **data);
+    void commitBuffer(int idx);
+    // ends the recording; finished() is emitted when the file is complete
+    void stop();
+
+    bool active() const { return m_pid > 0; }
+    QString fileName() const { return m_fileName; }
+    int droppedFrames() const { return m_dropped.load(); }
+    int writtenFrames() const { return m_written.load(); }
+
+Q_SIGNALS:
+    void finished(bool ok, const QString &fileName);
+
+private:
+    void writerLoop();
+    void waitLoop();
+    void convert(const QImage &frame, int rotation, bool mirror, double zoom, uint8_t *out, double gain = 1.0,
+                 double wb0 = 1.0, double wb2 = 1.0) const;
+    int m_pRotation = 0;
+    bool m_pMirror = false;
+    double m_pZoom = 1.0, m_pGain = 1.0, m_pWb0 = 1.0, m_pWb2 = 1.0;
+
+    QString m_fileName;
+    int m_width = 0, m_height = 0;
+    bool m_hardware = false;
+    int m_fd = -1;
+    pid_t m_pid = -1;
+    size_t m_frameSize = 0;
+
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::vector<std::vector<uint8_t>> m_pool;
+    // r43: the frame (shared QImage, no copy) and its parameters per buffer; converted in the writer thread, not in the
+    // busy GUI thread (only 39 frames reached the encoder in 21 s)
+    struct Pending {
+        QImage image;
+        int rotation = 0;
+        bool mirror = false;
+        double zoom = 1.0;
+        double gain = 1.0, wb0 = 1.0, wb2 = 1.0;
+    };
+    std::vector<Pending> m_pending;
+    std::deque<int> m_free, m_work;
+    bool m_stopping = false;
+    std::thread m_writer;
+    std::thread m_waiter;
+    std::atomic<int> m_dropped{0};
+    std::atomic<int> m_written{0}; // r43
+};
