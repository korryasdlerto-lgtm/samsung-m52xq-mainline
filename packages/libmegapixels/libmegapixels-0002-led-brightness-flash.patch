@@ -26,16 +29,55 @@
 
 	snprintf(result, PATH_MAX, "%s/flash_strobe", path);
 
+	/*
+	 * m52xq: the flash LED (sm5714 "white:flash") is a plain LED class device without flash_strobe: drive it through
+	 * "brightness" (max_brightness while the flash is on, 0 afterwards).
+	 */
+	if (access(result, F_OK) != 0) {
+		snprintf(result, PATH_MAX, "%s/brightness", path);
+	}
+
 	return result;
 }
 
+static int
+flash_is_brightness(libmegapixels_camera *camera)
+{
+	size_t len = camera->flash_path ? strlen(camera->flash_path) : 0;
+
+	return len > 11 && strcmp(camera->flash_path + len - 11, "/brightness") == 0;
+}
+
+static int
+flash_max_brightness(libmegapixels_camera *camera)
+{
+	char path[PATH_MAX];
+	int max = 1;
+	size_t len = strlen(camera->flash_path);
+	FILE *f;
+
+	snprintf(path, sizeof(path), "%.*s/max_brightness", (int)(len - 11), camera->flash_path);
+	f = fopen(path, "r");
+	if (f) {
+		if (fscanf(f, "%d", &max) != 1 || max < 1) {
+			max = 1;
+		}
+		fclose(f);
+	}
+	return max;
+}
+
