# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=plasma-dialer
pkgver=6.7.5
pkgrel=100
pkgdesc="A dialer for Plasma Mobile (m52xq: DTMF key tones via libcanberra)"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/plasma-mobile/plasma-dialer"
license="GPL-2.0-or-later"
depends="
	kirigami-addons
	kirigami
	oxygen-sounds
	qt6-qtmultimedia
	"
makedepends="
	extra-cmake-modules
	callaudiod-dev
	kcontacts-dev
	kcoreaddons-dev
	kdbusaddons-dev
	ki18n-dev
	libcanberra-dev
	kio-dev
	kirigami-addons-dev
	knotifications-dev
	kpeople-dev
	libphonenumber-dev
	modemmanager-qt-dev
	pulseaudio-qt-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	reuse
	samurai
	"
subpackages="$pkgname-lang"

case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac

_repo_url="https://invent.kde.org/plasma-mobile/plasma-dialer.git"
source="https://download.kde.org/$_rel/plasma/$pkgver/plasma-dialer-$pkgver.tar.xz
	plasma-dialer-0003-key-tones-canberra.patch
	plasma-dialer-0004-default-open-action.patch
	plasma-dialer-0005-m52xq-dual-sim.patch
	plasma-dialer-0006-m52xq-speaker-sync.patch
	plasma-dialer-0007-m52xq-add-contact.patch
	dtmf-clear.wav
	dtmf-delete.wav
	dtmf-0.wav
	dtmf-1.wav
	dtmf-2.wav
	dtmf-3.wav
	dtmf-4.wav
	dtmf-5.wav
	dtmf-6.wav
	dtmf-7.wav
	dtmf-8.wav
	dtmf-9.wav
	dtmf-hash.wav
	dtmf-star.wav
	"
options="!check" # No tests

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	for f in "$srcdir"/dtmf-*.wav; do
		install -Dm644 "$f" "$pkgdir"/usr/share/sounds/m52xq/"${f##*/}"
	done
}

