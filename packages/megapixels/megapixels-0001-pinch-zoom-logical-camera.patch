+// m52xq r69: thumbnail of the last frame the viewfinder showed, read before the sensor switches to the capture mode
+static void
+snapshot_thumb(struct _MPPipeline *pipeline, const void *data)
+{
+        if (pending_thumb) {
+                g_object_unref(pending_thumb);
+                pending_thumb = NULL;
+        }
+        if (!last_shown_buffer || output_buffer_width <= 0 || output_buffer_height <= 0)
+                return;
+        int w = output_buffer_width, h = output_buffer_height;
+        GLuint fb;
+        GLint prev_fb;
+        glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prev_fb);
+        glGenFramebuffers(1, &fb);
+        glBindFramebuffer(GL_FRAMEBUFFER, fb);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, last_shown_buffer->texture_id, 0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+                size_t size = (size_t)w * h * 4;
+                uint32_t *d = g_malloc_n(size, 1);
+                glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, d);
+                for (int y = 0; y < h / 2; ++y) {
+                        for (int x = 0; x < w; ++x) {
+                                uint32_t t = d[(size_t)(h - y - 1) * w + x];
+                                d[(size_t)(h - y - 1) * w + x] = d[(size_t)y * w + x];
+                                d[(size_t)y * w + x] = t;
+                        }
+                }
+                pending_thumb = gdk_memory_texture_new(w, h, GDK_MEMORY_R8G8B8A8, g_bytes_new_take(d, size), w * 4);
+        }
+        glBindFramebuffer(GL_FRAMEBUFFER, prev_fb);
+        glDeleteFramebuffers(1, &fb);
+}
+
+void
+mp_process_pipeline_snapshot_thumb(void)
+{
+        mp_pipeline_invoke(pipeline, snapshot_thumb, NULL, 0);
+}
