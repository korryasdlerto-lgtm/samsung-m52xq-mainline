+static void
+focus_at(MPPipeline *pipe, const void *data)
+{
+	const af_roi_msg *m = data;
+	af_roi_u = m->u;
+	af_roi_v = m->v;
+	// the front camera has a fixed-focus lens (the only VCM, fp5529, moves the main camera lens): there the tap sets the
+	// exposure point like the stock camera; on the main camera it sets the focus point and the exposure point
+	// r81: only on the front camera the exposure follows the tap; on the main camera a changing exposure during the focus
+	// scan changed the "sharpness" with it and the scan picked a wrong lens position (completely blurred photo)
+	if (front_camera()) {
+		ae_locked = false;
+		ae_stable = 0;
+		ae_settle = 1;
+	} else {
+		af_holdoff = 0;
+		auto_focus_start();
+	}
+	printf("AF/AE: tap at %.2f %.2f%s\n", m->u, m->v, front_camera() ? " (exposure only)" : "");
+}
+
+void
+mp_process_pipeline_focus_at(float u, float v)
+{
+	af_roi_msg m = { u, v };
+	mp_pipeline_invoke(pipeline, focus_at, &m, sizeof(m));
