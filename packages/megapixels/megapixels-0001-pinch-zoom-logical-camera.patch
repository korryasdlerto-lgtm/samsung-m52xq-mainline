+	"uniform vec2 in_size;\n"    // r76: the frame as the viewfinder shows it
+	"uniform float rot;\n"
+	"uniform float mirror;\n"
+	// output pixel position (top-left origin) -> the viewfinder texture: transpose=1 / transpose=2 / 180, then un-mirror
+	"vec3 at(float x, float y) {\n"
+	// r78: the mirror belongs to the upright output (rotate the viewfinder frame first, then un-mirror it): mirroring the
+	// input turned the landscape front videos upside down
+	"  if (mirror > 0.5) x = src_size.x - x;\n"
+	"  vec2 s = vec2(x, y);\n"
+	"  if (rot > 0.5 && rot < 1.5) s = vec2(y, in_size.y - x);\n"
+	"  else if (rot > 1.5 && rot < 2.5) s = vec2(in_size.x - y, x);\n"
+	"  else if (rot > 2.5) s = vec2(in_size.x - x, in_size.y - y);\n"
+	"  return texture2D(tex, vec2(s.x / in_size.x, 1.0 - s.y / in_size.y)).rgb;\n"
+	"}\n"
+	"float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }\n"
+	"float y8(vec3 c) { return (16.0 + 219.0 * luma(c)) / 255.0; }\n"
+	"vec2 uv8(vec3 c) { float y = luma(c); return vec2(128.0 + 224.0 * (c.b - y) / 1.8556, 128.0 + 224.0 * (c.r - y) / 1.5748) / 255.0; }\n"
+	"void main() {\n"
+	"  float ox = floor(gl_FragCoord.x);\n"
+	"  float oy = floor(gl_FragCoord.y);\n"
+	"  float w = src_size.x;\n"
+	"  float h = src_size.y;\n"
+	"  if (oy < h) {\n"
+	"    float y = oy + 0.5;\n"
+	"    gl_FragColor = vec4(y8(at(4.0 * ox + 0.5, y)), y8(at(4.0 * ox + 1.5, y)),\n"
+	"                        y8(at(4.0 * ox + 2.5, y)), y8(at(4.0 * ox + 3.5, y)));\n"
+	"  } else {\n"
+	"    float rc = oy - h;\n"
+	"    float y = 2.0 * rc + 1.0;\n"
+	"    vec2 a = uv8(at(4.0 * ox + 1.0, y));\n"
+	"    vec2 b = uv8(at(4.0 * ox + 3.0, y));\n"
+	"    gl_FragColor = vec4(a.x, a.y, b.x, b.y);\n"
+	"  }\n"
+	"}\n";
+
+static GLuint nv12_program = 0, nv12_fbo = 0, nv12_tex = 0;
+static bool nv12_tex_new = false;
+static int enc4k_tex_w = 0, enc4k_tex_h = 0, nv12_out_w = 0;
+static GLint nv12_u_tex = -1, nv12_u_size = -1, nv12_u_in = -1, nv12_u_rot = -1, nv12_u_mirror = -1;
+
+static GLuint
+nv12_compile(GLenum type, const char *src)
+{
+	GLuint sh = glCreateShader(type);
+	glShaderSource(sh, 1, &src, NULL);
+	glCompileShader(sh);
+	GLint ok = 0;
+	glGetShaderiv(sh, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[512];
+		glGetShaderInfoLog(sh, sizeof(log), NULL, log);
+		printf("movie encoder: NV12 shader compile failed: %s\n", log);
+	}
+	return sh;
+}
+
+static void
+movie_encoder_frame_4k(GLuint input_texture)
+{
+	g_mutex_lock(&enc_lock);
+	if (movie_encoder_active && enc_4k && enc_proc && enc_stdin && gles2_debayer != NULL) {
+		if (enc4k_tex != 0 && (enc4k_tex_w != enc_src_w || enc4k_tex_h != enc_src_h || nv12_out_w != enc_w)) {
+			glDeleteTextures(1, &enc4k_tex);
+			enc4k_tex = 0;
+			if (nv12_tex != 0) {
+				glDeleteTextures(1, &nv12_tex);
+				nv12_tex = 0;
+				nv12_tex_new = true;
+			}
+		}
+		if (enc4k_tex == 0) {
+			enc4k_tex_w = enc_src_w;
+			enc4k_tex_h = enc_src_h;
+			nv12_out_w = enc_w;
+			glGenTextures(1, &enc4k_tex);
+			glBindTexture(GL_TEXTURE_2D, enc4k_tex);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, enc_src_w, enc_src_h, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+			glBindTexture(GL_TEXTURE_2D, 0);
+			check_gl();
+		}
+		if (nv12_program != 0 && nv12_tex == 0) { // the size changed: only the output texture is new
+			glGenTextures(1, &nv12_tex);
+			glBindTexture(GL_TEXTURE_2D, nv12_tex);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, enc_w / 4, enc_h * 3 / 2, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+			glBindTexture(GL_TEXTURE_2D, 0);
+			nv12_tex_new = false;
+		}
+		if (nv12_program == 0) {
+			GLuint vs = nv12_compile(GL_VERTEX_SHADER, nv12_vs_src);
+			GLuint fs = nv12_compile(GL_FRAGMENT_SHADER, nv12_fs_src);
+			nv12_program = glCreateProgram();
+			glAttachShader(nv12_program, vs);
+			glAttachShader(nv12_program, fs);
+			glBindAttribLocation(nv12_program, 0, "vert");
+			glBindAttribLocation(nv12_program, 1, "tex_coord");
+			glLinkProgram(nv12_program);
+			GLint ok = 0;
+			glGetProgramiv(nv12_program, GL_LINK_STATUS, &ok);
+			if (!ok) {
+				printf("movie encoder: NV12 program link failed\n");
+			}
+			nv12_u_tex = glGetUniformLocation(nv12_program, "tex");
+			nv12_u_size = glGetUniformLocation(nv12_program, "src_size");
+			nv12_u_in = glGetUniformLocation(nv12_program, "in_size");
+			nv12_u_rot = glGetUniformLocation(nv12_program, "rot");
+			nv12_u_mirror = glGetUniformLocation(nv12_program, "mirror");
+			glGenTextures(1, &nv12_tex);
+			glBindTexture(GL_TEXTURE_2D, nv12_tex);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+			glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+			glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, enc_w / 4, enc_h * 3 / 2, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+			glBindTexture(GL_TEXTURE_2D, 0);
+			glGenFramebuffers(1, &nv12_fbo);
+			check_gl();
+		}
+		static double st_p1, st_p2, st_wr;
+		static int st_n;
+		uint8_t *wbuf = g_async_queue_try_pop(enc_free_q);
+		if (wbuf == NULL) { // the writer is behind: drop this frame (the viewfinder keeps running)
+			enc_dropped++;
+			g_mutex_unlock(&enc_lock);
+			return;
+		}
+		double st_t0 = m52xq_now_ms();
+		// pass 1: debayer the (cropped) full sensor frame into the 4K RGBA texture
+		gles2_debayer_process_viewport(gles2_debayer, enc4k_tex, input_texture, enc4k_vx, enc4k_vy, enc4k_vw, enc4k_vh,
+					       output_buffer_width, output_buffer_height);
+		glFinish();
+		double st_t1 = m52xq_now_ms();
+		// pass 2: RGBA -> NV12 on the GPU
+		glBindFramebuffer(GL_FRAMEBUFFER, nv12_fbo);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, nv12_tex, 0);
+		glViewport(0, 0, enc_w / 4, enc_h * 3 / 2);
+		glUseProgram(nv12_program);
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, enc4k_tex);
+		glUniform1i(nv12_u_tex, 0);
+		glUniform2f(nv12_u_size, (float)enc_w, (float)enc_h);
+		glUniform2f(nv12_u_in, (float)enc_src_w, (float)enc_src_h);
+		glUniform1f(nv12_u_rot, (float)enc_rot);
+		glUniform1f(nv12_u_mirror, (float)enc_mirror);
+		gl_util_draw_quad(0);
+		glReadPixels(0, 0, enc_w / 4, enc_h * 3 / 2, GL_RGBA, GL_UNSIGNED_BYTE, wbuf);
+		double st_t2 = m52xq_now_ms();
+		// back to the viewfinder state: its program and viewport (its framebuffer is bound again by its own pass)
+		glUseProgram(gles2_debayer->program);
+		glViewport(0, 0, output_buffer_width, output_buffer_height);
+		check_gl();
+		g_async_queue_push(enc_work_q, wbuf);
+		double st_t3 = m52xq_now_ms();
+		st_p1 += st_t1 - st_t0;
+		st_p2 += st_t2 - st_t1;
+		st_wr += st_t3 - st_t2;
+		if (++st_n == 30) {
+			printf("MOVIE-TIME per frame: debayer pass %.1f ms, pack+readback %.1f ms, queue %.1f ms, dropped so far %d\n", st_p1 / st_n, st_p2 / st_n, st_wr / st_n, enc_dropped);
+			st_p1 = st_p2 = st_wr = 0;
+			st_n = 0;
+		}
+	}
+	g_mutex_unlock(&enc_lock);
+}
+
+bool
+mp_process_pipeline_movie_is_cropped(void)
+{
+	return movie_encoder_active && enc_4k;
+}
+
+static void
+movie_encoder_stop(void)
+{
+	g_mutex_lock(&enc_lock);
+	GSubprocess *proc = enc_proc;
+	GThread *wthread = enc_thread;
+	enc_thread = NULL;
+	movie_encoder_active = false;
+	if (wthread) {
+		g_async_queue_push(enc_work_q, &enc_stop_marker); // the writer drains the frames in the queue, then stops
+	}
+	g_mutex_unlock(&enc_lock);
+	if (wthread) {
+		g_thread_join(wthread);
+		g_mutex_lock(&enc_lock);
+		for (int bi = 0; bi < ENC_NBUF; bi++) {
+			g_free(enc_pool[bi]);
+			enc_pool[bi] = NULL;
+		}
+		g_async_queue_unref(enc_free_q);
+		g_async_queue_unref(enc_work_q);
+		enc_free_q = enc_work_q = NULL;
+		printf("movie encoder: 4K frames dropped because the writer was busy: %d\n", enc_dropped);
+		g_mutex_unlock(&enc_lock);
+	}
+	g_mutex_lock(&enc_lock);
+	if (enc_stdin) {
+		g_output_stream_close(enc_stdin, NULL, NULL);
+		enc_stdin = NULL;
+	}
+	enc_proc = NULL;
+	enc_4k = false;
+	g_free(enc_buf);
+	enc_buf = NULL;
+	g_mutex_unlock(&enc_lock);
+	if (proc) {
+		g_subprocess_send_signal(proc, SIGINT); // ffmpeg (software) / the shell trap (hardware: gst-launch -e) finishes the file cleanly
+		g_subprocess_wait_async(proc, NULL, movie_encoder_finished, NULL);
+	}
+}
