+static void
+remosaic_tetracell_raw10(const uint8_t *src, uint8_t *dst, int width, int height, size_t line)
+{
+	memcpy(dst, src, line * height); // keeps the padding bytes
+
+	// m52xq r68: the four pixels of a 2x2 cell (and the two green cells) differ slightly in sensitivity; moved apart by the
+	// re-mosaic that shows as a fine dot grid. Measure the mean of each of the 16 positions of the 4x4 block on a sample of the
+	// frame (pixels between black and saturation only) and scale every position to the mean of its colour.
+	static const int pos_color[4][4] = { { 1, 1, 0, 0 }, { 1, 1, 0, 0 }, { 2, 2, 1, 1 }, { 2, 2, 1, 1 } }; // 0 R 1 G 2 B
+	double sum[4][4] = { { 0 } }, cnt[4][4] = { { 0 } };
+	for (int y = 0; y + 4 <= height; y += 32) {
+		for (int gx = 0; gx < width / 4; gx += 8) {
+			for (int r = 0; r < 4; r++) {
+				const uint8_t *p = src + (size_t)(y + r) * line + (size_t)gx * 5;
+				for (int c = 0; c < 4; c++) {
+					int v = ((int)p[c] << 2) | ((p[4] >> (2 * c)) & 3);
+					if (v > 80 && v < 960) {
+						sum[r][c] += v - 64;
+						cnt[r][c] += 1;
+					}
+				}
+			}
+		}
+	}
+	double csum[3] = { 0 }, ccnt[3] = { 0 };
+	for (int r = 0; r < 4; r++)
+		for (int c = 0; c < 4; c++) {
+			csum[pos_color[r][c]] += sum[r][c];
+			ccnt[pos_color[r][c]] += cnt[r][c];
+		}
+	float gain[4][4];
+	for (int r = 0; r < 4; r++)
+		for (int c = 0; c < 4; c++) {
+			int k = pos_color[r][c];
+			double m = cnt[r][c] > 100 ? sum[r][c] / cnt[r][c] : 0;
+			double cm = ccnt[k] > 100 ? csum[k] / ccnt[k] : 0;
+			gain[r][c] = (m > 1 && cm > 1) ? (float)(cm / m) : 1.0f;
+			if (gain[r][c] < 0.8f || gain[r][c] > 1.25f)
+				gain[r][c] = 1.0f; // implausible (almost no flat pixels): leave it
+		}
+	printf("remosaic: cell gains G %.3f %.3f %.3f %.3f  R %.3f %.3f  B %.3f %.3f\n", gain[0][0], gain[0][1], gain[1][0],
+	       gain[1][1], gain[0][2], gain[1][3], gain[2][0], gain[3][1]);
+
+	for (int y = 0; y < height; y += 4) {
+		for (int gx = 0; gx < width / 4; gx++) {
+			uint16_t s[4][4];
+			for (int r = 0; r < 4; r++) {
+				const uint8_t *p = src + (size_t)(y + r) * line + (size_t)gx * 5;
+				for (int c = 0; c < 4; c++) {
+					int v = ((int)p[c] << 2) | ((p[4] >> (2 * c)) & 3);
+					if (v > 64 && v < 1023) {
+						v = 64 + (int)((v - 64) * gain[r][c] + 0.5f);
+						v = v > 1023 ? 1023 : v;
+					}
+					s[r][c] = (uint16_t)v;
+				}
+			}
+			for (int r = 0; r < 4; r++) {
+				uint8_t *q = dst + (size_t)(y + r) * line + (size_t)gx * 5;
+				uint8_t low = 0;
+				for (int c = 0; c < 4; c++) {
+					uint16_t v = s[remosaic_src[r][c][0]][remosaic_src[r][c][1]];
+					q[c] = v >> 2;
+					low |= (v & 3) << (2 * c);
+				}
+				q[4] = low;
+			}
+		}
+	}
+}
