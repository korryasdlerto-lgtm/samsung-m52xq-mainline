@@ -10,6 +10,9 @@
 uniform float blacklevel;
 uniform float row_length;
 uniform float padding_ratio;
+uniform float nr; // m52xq r33: noise reduction strength 0..1 (average of 3x3 neighbouring 2x2 blocks)
+uniform vec2 pixel_size;
+uniform float snap_quad; // m52xq r44: 1.0 = read the nearest whole 2x2 Bayer quad (the 4K video pass scales by a non-integer factor)
 
 varying vec2 top_left_uv;
