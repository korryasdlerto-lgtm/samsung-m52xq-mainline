     #else
-    vec3 color = vec3(samples.x, (samples.y + samples.z) / 2.0, samples.w);
+    return vec3(samples.x, (samples.y + samples.z) / 2.0, samples.w);
     #endif
+}
+
+void
+main()
+{
+    // Note the coordinates for texture samples need to be a varying, as the
+    // Mali-400 has this as a fast path allowing 32-bit floats. Otherwise
+    // they end up as 16-bit floats and that's not accurate enough.
+    vec2 tl = top_left_uv;
+    vec2 tr = top_right_uv;
+    vec2 bl = bottom_left_uv;
+    vec2 br = bottom_right_uv;
+    if (snap_quad > 0.5) {
+        // m52xq r44: the 4K video pass maps one output pixel to ~1.2 raw pixels: the 2x2 block around the pixel centre then has a
+        // random colour filter phase (wrong red/green/blue assignment: blue cast, grid). Snap to the nearest aligned quad.
+        vec2 c = (top_left_uv + bottom_right_uv) * 0.5;
+        vec2 q = (floor(c / pixel_size * 0.5) * 2.0 + 1.0) * pixel_size;
+        tl = q - pixel_size * 0.5;
+        br = q + pixel_size * 0.5;
+        tr = vec2(br.x, tl.y);
+        bl = vec2(tl.x, br.y);
+    }
+    vec3 color = block_color(tl, tr, bl, br);
+    if (nr > 0.01) {
+        // m52xq r33: average the colour of the 3x3 neighbouring blocks (offsets are multiples of 2 raw pixels so the
+        // colour filter phase stays the same), blended in by the strength nr
+        vec3 sum = vec3(0.0);
+        for (int j = -1; j <= 1; j++) {
+            for (int i = -1; i <= 1; i++) {
+                vec2 off = vec2(float(i), float(j)) * 2.0 * pixel_size;
+                sum += block_color(tl + off, tr + off, bl + off, br + off);
+            }
+        }
+        color = mix(color, sum / 9.0, nr);
+    }
 
     color -= blacklevel;
     color *= color_matrix;
 
-    vec3 gamma_color = pow(color, vec3(inv_gamma));
+    vec3 gamma_color = clamp(pow(max(color, vec3(0.0)), vec3(inv_gamma)), 0.0, 1.0);
+    // m52xq r26: contrast S-curve (k=0.5) and +25 % saturation, identical in postprocess.sh / mpegize.py
+    gamma_color += 0.5 * (gamma_color * gamma_color * (3.0 - 2.0 * gamma_color) - gamma_color);
+    float m52xq_luma = dot(gamma_color, vec3(0.299, 0.587, 0.114));
+    gamma_color = clamp(vec3(m52xq_luma) + (gamma_color - vec3(m52xq_luma)) * 1.25, 0.0, 1.0);
     gl_FragColor = vec4(gamma_color, 1);
 }
