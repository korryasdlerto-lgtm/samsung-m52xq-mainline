# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=plasma-keyboard
pkgver=6.7.5
pkgrel=93
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
url="https://invent.kde.org/plasma/plasma-keyboard"
pkgdesc="Virtual keyboard for Qt-based desktops"
license="(GPL-2.0-only OR GPL-3.0-only) AND (LGPL-2.1-only OR LGPL-3.0-only)"
makedepends="
	extra-cmake-modules
	kcmutils-dev
	kcoreaddons-dev
	ki18n-dev
	libplasma-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtdeclarative-private-dev
	qt6-qtvirtualkeyboard-dev
	qt6-qtwayland-dev
	samurai
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-lang"

case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac

# strip fourth version component for source URL
case "$pkgver" in
	*.*.*.*) _pkgver="${pkgver%.*}" ;;
	*) _pkgver="$pkgver" ;;
esac

_repo_url="https://invent.kde.org/plasma/plasma-keyboard.git"
source="https://download.kde.org/$_rel/plasma/$_pkgver/plasma-keyboard-$pkgver.tar.xz
	plasma-keyboard-0001-fix-sound-option-name.patch
	keyboard_tick2_m52xq_x40soft.wav
	"
options="!check" # No tests

prepare() {
	default_prepare
	# m52xq: stock tick peaks at -21 dBFS, inaudible on the phone speaker; same click x40 with tanh soft clip
	cp "$srcdir"/keyboard_tick2_m52xq_x40soft.wav src/sounds/keyboard_tick2_quiet.wav
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

