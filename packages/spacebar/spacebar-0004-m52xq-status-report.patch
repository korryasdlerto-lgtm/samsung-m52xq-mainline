+static QString m52xqDigits9(const QString &number)
+{
+    QString d;
+    for (const QChar c : number) {
+        if (c.isDigit()) {
+            d += c;
+        }
+    }
+    return d.right(9);
+}
+
+void ChannelLogger::handleStatusReport(ModemManager::Sms::Ptr msg)
+{
+    const QString num = m52xqDigits9(msg->number());
+    const uint ref = msg->messageReference();
+    const int ds = static_cast<int>(msg->deliveryState());
+    QString id = m_sentByRef.value(num + QLatin1Char(':') + QString::number(ref));
+    if (id.isEmpty()) {
+        id = m_lastSentTo.value(num); // no reference known (the report came after a restart): the last message sent to this number
+    }
+    qDebug() << "status report from" << msg->number() << "reference" << ref << "delivery state" << ds << "-> message" << id;
+    if (id.isEmpty()) {
+        return;
+    }
+    // 3GPP TS 23.040: 0x00-0x02 delivered; 0x20-0x3f temporary error (the SMSC retries: nothing to show yet); 0x40-0xff not delivered
+    MessageState state;
+    if (ds >= 0 && ds <= 0x02) {
+        state = MessageState::Delivered;
+    } else if (ds >= 0x40 && ds < 0x100) {
+        state = MessageState::Failed;
+    } else {
+        return;
+    }
+    m_database.updateMessageDeliveryState(id, state);
+    Message message;
+    message.id = id;
+    message.phoneNumberList = PhoneNumberList(msg->number());
+    message.deliveryStatus = state;
+    updateMessage(message);
+}
